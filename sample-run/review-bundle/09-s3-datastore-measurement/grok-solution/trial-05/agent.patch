+        if (platform.toLowerCase() === SupportedDatastores.s3 && accountId && businessID && measurementId) {
+            const externalId = dbAccessInformation.externalId || randomUUID();
+            const roleName = DatastoreAccessInformation.roleNameFor(businessID, measurementId);
+            const iam = new IAM({ region: process.env.AWS_REGION || region });
+            const trustPolicy = DatastoreAccessInformation.trustPolicy(accountId, externalId);
+            const created = await iam.createRole({
+                RoleName: roleName,
+                AssumeRolePolicyDocument: JSON.stringify(trustPolicy),
+                Description: `MeteringCo S3 datastore ingestion role for business ${businessID}`,
+            });
+            await iam.putRolePolicy({
+                RoleName: roleName,
+                PolicyName: `${roleName}-policy`,
+                PolicyDocument: JSON.stringify(DatastoreAccessInformation.accessPolicy(businessID)),
+            });
+            dbAccessInformation.externalId = externalId;
+            dbAccessInformation.iamRoleArn = created?.Role?.Arn || `arn:aws:iam::${accountId}:role/${roleName}`;
+            dbAccessInformation.ingestion = DatastoreAccessInformation.ingestionUri(businessID);
+            dbAccessInformation.dlq = DatastoreAccessInformation.dlqUri(businessID);
+        } else if (platform.toLowerCase() === SupportedDatastores.s3) {
+            dbAccessInformation.ingestion =
+                dbAccessInformation.ingestion ||
+                (businessID ? DatastoreAccessInformation.ingestionUri(businessID) : dbAccessInformation.ingestion);
+            dbAccessInformation.dlq =
+                dbAccessInformation.dlq ||
+                (businessID ? DatastoreAccessInformation.dlqUri(businessID) : dbAccessInformation.dlq);
+            if (!dbAccessInformation.externalId) {
+                dbAccessInformation.externalId = randomUUID();
             }
         }
+        return dbAccessInformation;
+    }
+
+    public static async updateAccess(dbAccessInformation: DatastoreAccessInformation) {
+        const accountId = dbAccessInformation.accountId || dbAccessInformation.cloudId;
+        const { businessID, measurementId, iamRoleArn, externalId } = dbAccessInformation;
+        const region = dbAccessInformation.region || DEFAULT_DATASTORE_REGION;
+        if (!accountId || !externalId) {
+            return dbAccessInformation;
+        }
+        const roleName =
+            (iamRoleArn && iamRoleArn.split('/').pop()) ||
+            (businessID && measurementId && DatastoreAccessInformation.roleNameFor(businessID, measurementId));
+        if (!roleName) {
+            return dbAccessInformation;
+        }
+        const iam = new IAM({ region: process.env.AWS_REGION || region });
+        await iam.updateAssumeRolePolicy({
+            RoleName: roleName,
+            PolicyDocument: JSON.stringify(DatastoreAccessInformation.trustPolicy(accountId, externalId)),
+        });
+        dbAccessInformation.accountId = accountId;
+        return dbAccessInformation;
     }
 }
 
