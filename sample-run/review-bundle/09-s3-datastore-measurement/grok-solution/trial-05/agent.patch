@@ -0,0 +1,154 @@
+import { IAM } from '@aws-sdk/client-iam';
+import { S3 } from '@aws-sdk/client-s3';
+import { measurementMode } from '../dto/create-measurement-config.dto';
+import { DatastoreAccessInformation, MeasurementConfigEntity } from './measurement-config.entity';
+import { StandardMeasurementEntity } from './standardMeasurement.entity';
+import { PrivateAPIUsageController } from '../../usage/usage.controller';
+
+jest.mock('@aws-sdk/client-iam', () => {
+    const createRole = jest.fn().mockResolvedValue({
+        Role: { Arn: 'arn:aws:iam::999999999999:role/datastore-biz-mid' },
+    });
+    const putRolePolicy = jest.fn().mockResolvedValue({});
+    const updateAssumeRolePolicy = jest.fn().mockResolvedValue({});
+    return {
+        IAM: jest.fn().mockImplementation(() => ({
+            createRole,
+            putRolePolicy,
+            updateAssumeRolePolicy,
+        })),
+    };
+});
+
+jest.mock('@aws-sdk/client-s3', () => {
+    const putObject = jest.fn().mockResolvedValue({});
+    return {
+        S3: jest.fn().mockImplementation(() => ({
+            putObject,
+        })),
+    };
+});
+
+describe('S3 datastore-based usage measurement', () => {
+    const originalEnv = process.env;
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+        process.env = {
+            ...originalEnv,
+            DB_MEASUREMENT_BUCKET_NAME: 'ingest-bucket',
+            DB_MEASUREMENT_DLQ_BUCKET_NAME: 'dlq-bucket',
+            AWS_REGION: 'us-east-1',
+        };
+    });
+
+    afterAll(() => {
+        process.env = originalEnv;
+    });
+
+    it('defaults omitted platform and region and provisions a unique IAM role', async () => {
+        const config = new DatastoreAccessInformation({
+            accountId: '123456789012',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+        } as DatastoreAccessInformation);
+
+        expect(config.platform).toBe('s3');
+        expect(config.region).toBe('us-east-1');
+
+        await DatastoreAccessInformation.setupAccess(config);
+
+        const iamInstance = (IAM as unknown as jest.Mock).mock.results[0].value;
+        expect(iamInstance.createRole).toHaveBeenCalledWith(
+            expect.objectContaining({
+                RoleName: 'datastore-biz-1-meas-1',
+            })
+        );
+        const trust = JSON.parse(iamInstance.createRole.mock.calls[0][0].AssumeRolePolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::123456789012:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe(config.externalId);
+        expect(iamInstance.putRolePolicy).toHaveBeenCalled();
+        const policy = JSON.parse(iamInstance.putRolePolicy.mock.calls[0][0].PolicyDocument);
+        expect(JSON.stringify(policy)).toContain('ingest-bucket/biz-1/*');
+        expect(JSON.stringify(policy)).toContain('dlq-bucket/biz-1/*');
+        expect(config.iamRoleArn).toBeTruthy();
+        expect(config.ingestion).toBe('s3://ingest-bucket/biz-1/');
+        expect(config.dlq).toBe('s3://dlq-bucket/biz-1/');
+        expect(config.externalId).toBeTruthy();
+    });
+
+    it('updates role trust while preserving role and external id', async () => {
+        const config = new DatastoreAccessInformation({
+            accountId: '222222222222',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+            iamRoleArn: 'arn:aws:iam::999999999999:role/datastore-biz-1-meas-1',
+            externalId: 'keep-me',
+            platform: 's3',
+            region: 'us-east-1',
+        } as DatastoreAccessInformation);
+
+        await DatastoreAccessInformation.updateAccess(config);
+        const iamInstance = (IAM as unknown as jest.Mock).mock.results[0].value;
+        expect(iamInstance.updateAssumeRolePolicy).toHaveBeenCalledWith(
+            expect.objectContaining({
+                RoleName: 'datastore-biz-1-meas-1',
+            })
+        );
+        const trust = JSON.parse(iamInstance.updateAssumeRolePolicy.mock.calls[0][0].PolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::222222222222:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe('keep-me');
+        expect(config.iamRoleArn).toBe('arn:aws:iam::999999999999:role/datastore-biz-1-meas-1');
+        expect(config.externalId).toBe('keep-me');
+    });
+
+    it('routes valid db usage records to UsageService.create', async () => {
+        const create = jest.fn().mockResolvedValue({ message: 'Measurement created' });
+        const controller = new PrivateAPIUsageController({ create } as any);
+        const record = {
+            dimensionId: 'dim-1',
+            recordValue: '1',
+            timeStamp: '2024-01-01T00:00:00Z',
+        };
+        await controller.dbUsage({
+            message: JSON.stringify(record),
+            s3Key: 'biz-99/path/file.json',
+        } as any);
+        expect(create).toHaveBeenCalledWith({ ...record, businessID: 'biz-99' });
+    });
+
+    it('writes malformed records to the mirrored DLQ key', async () => {
+        await StandardMeasurementEntity.publishFailureToDLQ({
+            s3Key: 's3://ingest-bucket/biz-99/path/file.json',
+            message: 'not-json',
+            error: new Error('boom'),
+            businessID: 'biz-99',
+        });
+        const s3Instance = (S3 as unknown as jest.Mock).mock.results[0].value;
+        expect(s3Instance.putObject).toHaveBeenCalledWith(
+            expect.objectContaining({
+                Bucket: 'dlq-bucket',
+                Key: 'biz-99/path/file.json.message.text',
+            })
+        );
+        const body = JSON.parse(s3Instance.putObject.mock.calls[0][0].Body);
+        expect(body.failedInput).toBe('not-json');
+        expect(body.processingMetadata).toBeTruthy();
+    });
+
+    it('setupAccessIfRequired is invoked from the measurement entity boundary', async () => {
+        const entity = new MeasurementConfigEntity({
+            measurementId: 'meas-2',
+            measurementMode: measurementMode.datastoreBased,
+            measurementConfiguration: { accountId: '123456789012' } as any,
+            businessID: 'biz-2',
+            subject: 'sub',
+            measurementName: 's3 ingest',
+        });
+        await MeasurementConfigEntity.setupAccessIfRequired(entity);
+        const cfg = entity.measurementConfiguration as DatastoreAccessInformation;
+        expect(cfg.iamRoleArn).toBeTruthy();
+        expect(cfg.platform).toBe('s3');
+        expect(cfg.region).toBe('us-east-1');
+    });
+});
