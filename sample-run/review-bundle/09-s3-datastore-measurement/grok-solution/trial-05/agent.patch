+
+    static normalizeDlqKey(s3Key: string) {
+        const raw = s3Key || '';
+        const schemeMatch = raw.match(/^s3:\/\/[^/]+\/(.*)$/i);
+        const relative = (schemeMatch ? schemeMatch[1] : raw).replace(/^\/+/, '');
+        return `${relative}.message.text`;
+    }
+
+    static async publishFailureToDLQ({
+        s3Key,
+        message,
+        error,
+        businessID,
+        metadata,
+    }: {
+        s3Key?: string;
+        message?: unknown;
+        error?: unknown;
+        businessID?: string;
+        metadata?: Record<string, unknown>;
+    }) {
+        const bucket = process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME;
+        const region = process.env.AWS_REGION || 'us-east-1';
+        const key = StandardMeasurementEntity.normalizeDlqKey(s3Key || '');
+        const failedInput =
+            typeof message === 'string'
+                ? message
+                : message === undefined
+                ? ''
+                : JSON.stringify(message);
+        const body = {
+            failedInput,
+            message,
+            s3Key,
+            businessID,
+            processingMetadata: {
+                error:
+                    error instanceof Error
+                        ? { name: error.name, message: error.message, stack: error.stack }
+                        : error,
+                processedAt: new Date().toISOString(),
+                ...metadata,
+            },
+        };
+        if (!bucket) {
+            AuditService.publishEvent({
+                data: [body],
+                message: 'Failed to publish malformed measurement to DLQ: missing bucket',
+                topic: AuditScope.ERROR,
+            });
+            return body;
+        }
+        const s3 = new S3({ region });
+        await s3.putObject({
+            Bucket: bucket,
+            Key: key,
+            Body: JSON.stringify(body),
+            ContentType: 'application/json',
+        });
+        return body;
+    }
 }
