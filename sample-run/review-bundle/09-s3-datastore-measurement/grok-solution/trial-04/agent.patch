+        dbAccessInformation.accountId = accountId;
+        return dbAccessInformation;
+    }
+
+    public static async updateAccess(dbAccessInformation: DatastoreAccessInformation) {
+        const accountId = dbAccessInformation.accountId;
+        const businessID = dbAccessInformation.businessID;
+        const measurementId = dbAccessInformation.measurementId;
+        const externalId = dbAccessInformation.externalId;
+        const region = dbAccessInformation.region || 'us-east-1';
+        if (!accountId || !externalId) {
+            throw new BadRequestException('accountId and externalId are required to update datastore access');
+        }
+
+        const roleName =
+            (dbAccessInformation.iamRoleArn && dbAccessInformation.iamRoleArn.split('/').pop()) ||
+            DatastoreAccessInformation.roleNameFor(businessID, measurementId);
+        const iam = DatastoreAccessInformation.iamClient(region);
+        await iam.updateAssumeRolePolicy({
+            RoleName: roleName,
+            PolicyDocument: JSON.stringify(DatastoreAccessInformation.trustPolicyFor(accountId, externalId)),
+        });
+        return dbAccessInformation;
     }
 }
 
