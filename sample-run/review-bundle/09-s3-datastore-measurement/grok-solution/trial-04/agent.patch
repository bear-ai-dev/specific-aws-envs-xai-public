+
+    /**
+     * Deliver a failed usage record to the configured DLQ bucket.
+     * The destination key mirrors the source key and appends `.message.text`.
+     * Already-relative source keys are accepted.
+     */
+    static async publishFailureToDLQ({
+        s3Key,
+        message,
+        error,
+        businessID,
+        metadata,
+    }: {
+        s3Key?: string;
+        message?: unknown;
+        error?: unknown;
+        businessID?: string;
+        metadata?: Record<string, unknown>;
+    }) {
+        const sourceKey = typeof s3Key === 'string' ? s3Key : '';
+        const relativeKey = sourceKey.replace(/^s3:\/\/[^/]+\//, '').replace(/^\/+/, '');
+        const derivedBusinessId = businessID || relativeKey.split('/')[0];
+        const destinationKey = `${relativeKey || derivedBusinessId || 'unknown'}.message.text`;
+        const failedInput = typeof message === 'string' ? message : JSON.stringify(message ?? null);
+        const processingMetadata = {
+            businessID: derivedBusinessId,
+            sourceKey,
+            destinationKey,
+            failedAt: new Date().toISOString(),
+            error:
+                error instanceof Error
+                    ? { name: error.name, message: error.message, stack: error.stack }
+                    : error,
+            ...(metadata || {}),
+        };
+        const body = JSON.stringify({
+            failedInput,
+            input: failedInput,
+            message,
+            metadata: processingMetadata,
+            processingMetadata,
+        });
+        await putDocument(body, process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME, destinationKey).done();
+        return { destinationKey, processingMetadata };
+    }
 }
