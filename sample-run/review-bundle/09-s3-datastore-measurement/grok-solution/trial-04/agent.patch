diff --git a/src/measurement-config/entities/datastore-access.entity.spec.ts b/src/measurement-config/entities/datastore-access.entity.spec.ts
new file mode 100644
index 0000000..5bd42ce
--- /dev/null
+++ b/src/measurement-config/entities/datastore-access.entity.spec.ts
@@ -0,0 +1,131 @@
+import { IAM } from '@aws-sdk/client-iam';
+import { measurementMode } from '../dto/create-measurement-config.dto';
+import {
+    DatastoreAccessInformation,
+    MeasurementConfigEntity,
+    SupportedDatastores,
+} from './measurement-config.entity';
+
+jest.mock('@aws-sdk/client-iam', () => {
+    const createRole = jest.fn();
+    const putRolePolicy = jest.fn();
+    const updateAssumeRolePolicy = jest.fn();
+    return {
+        IAM: jest.fn().mockImplementation(() => ({
+            createRole,
+            putRolePolicy,
+            updateAssumeRolePolicy,
+        })),
+        __mocks: { createRole, putRolePolicy, updateAssumeRolePolicy },
+    };
+});
+
+const { __mocks: iamMocks } = jest.requireMock('@aws-sdk/client-iam');
+
+describe('DatastoreAccessInformation', () => {
+    const originalEnv = process.env;
+
+    beforeEach(() => {
+        process.env = {
+            ...originalEnv,
+            DB_MEASUREMENT_BUCKET_NAME: 'meteringco-usage-record-dump-bucket',
+            DB_MEASUREMENT_DLQ_BUCKET_NAME: 'meteringco-usage-record-dlq-bucket',
+            AWS_REGION: 'us-east-1',
+        };
+        iamMocks.createRole.mockReset();
+        iamMocks.putRolePolicy.mockReset();
+        iamMocks.updateAssumeRolePolicy.mockReset();
+        iamMocks.createRole.mockResolvedValue({
+            Role: { Arn: 'arn:aws:iam::999999999999:role/datastore-biz-mid' },
+        });
+        iamMocks.putRolePolicy.mockResolvedValue({});
+        iamMocks.updateAssumeRolePolicy.mockResolvedValue({});
+        (IAM as unknown as jest.Mock).mockClear();
+    });
+
+    afterAll(() => {
+        process.env = originalEnv;
+    });
+
+    it('defaults omitted platform and region to s3 and us-east-1', () => {
+        const info = new DatastoreAccessInformation({
+            accountId: '111122223333',
+            businessID: 'biz',
+            measurementId: 'mid',
+        });
+        expect(info.platform).toBe(SupportedDatastores.s3);
+        expect(info.region).toBe('us-east-1');
+        expect(info.accountId).toBe('111122223333');
+    });
+
+    it('provisions a uniquely named role and prefix-scoped policy', async () => {
+        const info = new DatastoreAccessInformation({
+            accountId: '111122223333',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+        });
+
+        await DatastoreAccessInformation.setupAccess(info);
+
+        expect(iamMocks.createRole).toHaveBeenCalledTimes(1);
+        const createArgs = iamMocks.createRole.mock.calls[0][0];
+        expect(createArgs.RoleName).toBe('datastore-biz-1-meas-1');
+        const trust = JSON.parse(createArgs.AssumeRolePolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::111122223333:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe(info.externalId);
+
+        const policyArgs = iamMocks.putRolePolicy.mock.calls[0][0];
+        expect(policyArgs.RoleName).toBe('datastore-biz-1-meas-1');
+        const policy = JSON.parse(policyArgs.PolicyDocument);
+        const resources = policy.Statement.flatMap((s) => s.Resource);
+        expect(resources.some((r) => r.includes('meteringco-usage-record-dump-bucket/biz-1'))).toBe(true);
+        expect(resources.some((r) => r.includes('meteringco-usage-record-dlq-bucket/biz-1'))).toBe(true);
+
+        expect(info.iamRoleArn).toBe('arn:aws:iam::999999999999:role/datastore-biz-mid');
+        expect(info.externalId).toBeTruthy();
+        expect(info.ingestion).toBe('s3://meteringco-usage-record-dump-bucket/biz-1/');
+        expect(info.dlq).toBe('s3://meteringco-usage-record-dlq-bucket/biz-1/');
+        expect(info.platform).toBe('s3');
+        expect(info.region).toBe('us-east-1');
+    });
+
+    it('updates role trust while preserving role and external ID', async () => {
+        const info = new DatastoreAccessInformation({
+            accountId: '444455556666',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+            iamRoleArn: 'arn:aws:iam::999999999999:role/datastore-biz-1-meas-1',
+            externalId: 'kept-external-id',
+            platform: SupportedDatastores.s3,
+            region: 'us-east-1',
+        });
+
+        await DatastoreAccessInformation.updateAccess(info);
+
+        expect(iamMocks.updateAssumeRolePolicy).toHaveBeenCalledTimes(1);
+        const args = iamMocks.updateAssumeRolePolicy.mock.calls[0][0];
+        expect(args.RoleName).toBe('datastore-biz-1-meas-1');
+        const trust = JSON.parse(args.PolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::444455556666:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe('kept-external-id');
+        expect(info.iamRoleArn).toBe('arn:aws:iam::999999999999:role/datastore-biz-1-meas-1');
+        expect(info.externalId).toBe('kept-external-id');
+        expect(iamMocks.createRole).not.toHaveBeenCalled();
+    });
+
+    it('wires setupAccess through MeasurementConfigEntity', async () => {
+        const entity = new MeasurementConfigEntity({
+            measurementId: 'meas-2',
+            measurementMode: measurementMode.datastoreBased,
+            measurementConfiguration: { accountId: '123456789012' } as any,
+            businessID: 'acme',
+            subject: 'sub',
+            measurementName: 's3 ingest',
+        });
+        await MeasurementConfigEntity.setupAccessIfRequired(entity);
+        const config = entity.measurementConfiguration as DatastoreAccessInformation;
+        expect(config.iamRoleArn).toBeTruthy();
+        expect(config.accountId).toBe('123456789012');
+        expect(iamMocks.createRole.mock.calls[0][0].RoleName).toBe('datastore-acme-meas-2');
+    });
+});
