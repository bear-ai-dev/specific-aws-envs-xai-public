         }
     }
+
+    static normalizeS3Key(s3Key?: string): string {
+        if (!s3Key) {
+            return '';
+        }
+        if (s3Key.startsWith('s3://')) {
+            const withoutScheme = s3Key.substring('s3://'.length);
+            const firstSlash = withoutScheme.indexOf('/');
+            return firstSlash >= 0 ? withoutScheme.substring(firstSlash + 1) : '';
+        }
+        return s3Key.startsWith('/') ? s3Key.substring(1) : s3Key;
+    }
+
+    static async publishFailureToDLQ({
+        message,
+        s3Key,
+        error,
+        metadata,
+    }: {
+        message?: unknown;
+        s3Key?: string;
+        error?: any;
+        metadata?: Record<string, unknown>;
+    }) {
+        const relativeKey = StandardMeasurementEntity.normalizeS3Key(s3Key) || 'unknown';
+        const dlqKey = `${relativeKey}.message.text`;
+        const processingMetadata = {
+            error: error?.message || String(error || 'Unknown error'),
+            errorName: error?.name,
+            timestamp: new Date().toISOString(),
+            s3Key,
+            sourceKey: s3Key,
+            ...metadata,
+        };
+        const body = JSON.stringify({
+            message,
+            s3Key,
+            failedInput: { message, s3Key },
+            input: { message, s3Key },
+            processingMetadata,
+            metadata: processingMetadata,
+        });
+        const s3 = new S3({ region: process.env.AWS_REGION || 'us-east-1' });
+        await s3.putObject({
+            Bucket: process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME,
+            Key: dlqKey,
+            Body: body,
+            ContentType: 'application/json',
+        });
+        return { bucket: process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME, key: dlqKey };
+    }
 }
