+        const accountId = dbAccessInformation.accountId || dbAccessInformation.cloudId;
+        const platform = dbAccessInformation.platform || dbAccessInformation.datastoreType || SupportedDatastores.s3;
+        const region = dbAccessInformation.region || 'us-east-1';
+        const clientRegion = process.env.AWS_REGION || region;
+        const externalId = dbAccessInformation.externalId;
