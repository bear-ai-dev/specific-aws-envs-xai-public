diff --git a/src/measurement-config/entities/datastore-s3-access.spec.ts b/src/measurement-config/entities/datastore-s3-access.spec.ts
new file mode 100644
index 0000000..094e444
--- /dev/null
+++ b/src/measurement-config/entities/datastore-s3-access.spec.ts
@@ -0,0 +1,181 @@
+import { DatastoreAccessInformation, MeasurementConfigEntity } from './measurement-config.entity';
+import { measurementMode } from '../dto/create-measurement-config.dto';
+import { StandardMeasurementEntity } from './standardMeasurement.entity';
+import { PrivateAPIUsageController } from '../../usage/usage.controller';
+import { MeasurementConfigService } from '../measurement-config.service';
+
+const iamCalls: Record<string, any[]> = { createRole: [], putRolePolicy: [], updateAssumeRolePolicy: [] };
+const s3Calls: Record<string, any[]> = { putObject: [] };
+
+jest.mock('@aws-sdk/client-iam', () => {
+    class MockIAM {
+        createRole(input) {
+            iamCalls.createRole.push(input);
+            return Promise.resolve({ Role: { Arn: `arn:aws:iam::999:role/${input.RoleName}` } });
+        }
+        putRolePolicy(input) {
+            iamCalls.putRolePolicy.push(input);
+            return Promise.resolve({});
+        }
+        updateAssumeRolePolicy(input) {
+            iamCalls.updateAssumeRolePolicy.push(input);
+            return Promise.resolve({});
+        }
+    }
+    return { IAM: MockIAM };
+});
+
+jest.mock('@aws-sdk/client-s3', () => {
+    class MockS3 {
+        putObject(input) {
+            s3Calls.putObject.push(input);
+            return Promise.resolve({});
+        }
+    }
+    return { S3: MockS3 };
+});
+
+describe('S3 datastore-based usage measurement', () => {
+    beforeEach(() => {
+        Object.keys(iamCalls).forEach((k) => (iamCalls[k].length = 0));
+        Object.keys(s3Calls).forEach((k) => (s3Calls[k].length = 0));
+        process.env.DB_MEASUREMENT_BUCKET_NAME = 'ingest-bucket';
+        process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME = 'dlq-bucket';
+        process.env.AWS_REGION = 'us-east-1';
+        process.env.STAGE = 'dev';
+    });
+
+    it('provisions a uniquely named IAM role and policy and returns generated fields', async () => {
+        const info = new DatastoreAccessInformation({
+            accountId: '111122223333',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+        } as any);
+        await DatastoreAccessInformation.setupAccess(info);
+
+        expect(info.platform).toBe('s3');
+        expect(info.region).toBe('us-east-1');
+        expect(info.accountId).toBe('111122223333');
+        expect(info.iamRoleArn).toBe('arn:aws:iam::999:role/datastore-biz-1-meas-1');
+        expect(info.externalId).toBeTruthy();
+        expect(info.ingestion).toBe('s3://ingest-bucket/biz-1/');
+        expect(info.dlq).toBe('s3://dlq-bucket/biz-1/');
+
+        expect(iamCalls.createRole[0].RoleName).toBe('datastore-biz-1-meas-1');
+        const trust = JSON.parse(iamCalls.createRole[0].AssumeRolePolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::111122223333:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe(info.externalId);
+        const policy = JSON.parse(iamCalls.putRolePolicy[0].PolicyDocument);
+        const resources = policy.Statement.flatMap((s) => (Array.isArray(s.Resource) ? s.Resource : [s.Resource]));
+        expect(resources).toContain('arn:aws:s3:::ingest-bucket/biz-1/*');
+        expect(resources).toContain('arn:aws:s3:::dlq-bucket/biz-1/*');
+    });
+
+    it('updates role trust while preserving role and external ID', async () => {
+        const info = new DatastoreAccessInformation({
+            accountId: '111122223333',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+        } as any);
+        await DatastoreAccessInformation.setupAccess(info);
+        const previousExternal = info.externalId;
+        const previousArn = info.iamRoleArn;
+        info.accountId = '444455556666';
+        await DatastoreAccessInformation.updateAccess(info);
+        expect(iamCalls.updateAssumeRolePolicy[0].RoleName).toBe('datastore-biz-1-meas-1');
+        const updateTrust = JSON.parse(iamCalls.updateAssumeRolePolicy[0].PolicyDocument);
+        expect(updateTrust.Statement[0].Principal.AWS).toBe('arn:aws:iam::444455556666:root');
+        expect(updateTrust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe(previousExternal);
+        expect(info.externalId).toBe(previousExternal);
+        expect(info.iamRoleArn).toBe(previousArn);
+    });
+
+    it('writes malformed records to the DLQ under the mirrored source key', async () => {
+        await StandardMeasurementEntity.publishFailureToDLQ({
+            message: 'bad',
+            s3Key: 's3://ingest-bucket/biz-1/path/file.json',
+            error: new Error('boom'),
+        });
+        expect(s3Calls.putObject[0].Key).toBe('biz-1/path/file.json.message.text');
+        expect(s3Calls.putObject[0].Bucket).toBe('dlq-bucket');
+        const body = JSON.parse(s3Calls.putObject[0].Body);
+        expect(body.failedInput.message).toBe('bad');
+        expect(body.processingMetadata.error).toBe('boom');
+
+        await StandardMeasurementEntity.publishFailureToDLQ({
+            message: 'bad2',
+            s3Key: 'biz-1/already/relative.json',
+            error: new Error('oops'),
+        });
+        expect(s3Calls.putObject[1].Key).toBe('biz-1/already/relative.json.message.text');
+    });
+
+    it('routes valid S3 connector records through usage service using business ID from s3Key', async () => {
+        const usageService = { create: jest.fn(async (x) => ({ ok: true, x })) };
+        const ctrl = new PrivateAPIUsageController(usageService as any);
+        const rec = { timeStamp: '2023-01-01T00:00:00Z', recordValue: '1', dimensionId: 'd1' };
+        const res = await ctrl.dbUsage({ message: JSON.stringify(rec), s3Key: 'biz-9/a/b.json' } as any);
+        expect(res).toEqual({ ok: true, x: expect.objectContaining({ businessID: 'biz-9', dimensionId: 'd1' }) });
+        expect(usageService.create).toHaveBeenCalledWith(expect.objectContaining({ businessID: 'biz-9' }));
+    });
+
+    it('sends malformed connector records to the DLQ', async () => {
+        const usageService = { create: jest.fn() };
+        const ctrl = new PrivateAPIUsageController(usageService as any);
+        const res = await ctrl.dbUsage({ message: '{not json', s3Key: 's3://ingest-bucket/biz-9/a/b.json' } as any);
+        expect(res.message).toMatch(/DLQ/i);
+        expect(usageService.create).not.toHaveBeenCalled();
+        expect(s3Calls.putObject[0].Key).toBe('biz-9/a/b.json.message.text');
+    });
+
+    it('MeasurementConfigService.create provisions and persists generated configuration', async () => {
+        const loadPoints = jest.fn();
+        const service = new MeasurementConfigService(
+            { loadPoints, getPoint: () => ({ tag: jest.fn(), stringField: jest.fn() }) } as any,
+            {} as any,
+            {} as any
+        );
+        const created = await service.create(
+            {
+                businessID: 'biz-2',
+                measurementMode: measurementMode.datastoreBased,
+                measurementConfiguration: { accountId: '123456789012' },
+                measurementName: 's3 ingest',
+            } as any,
+            'subject'
+        );
+        expect(created.measurementId).toBeTruthy();
+        expect((created.measurementConfiguration as any).platform).toBe('s3');
+        expect((created.measurementConfiguration as any).accountId).toBe('123456789012');
+        expect((created.measurementConfiguration as any).iamRoleArn).toContain(`datastore-biz-2-${created.measurementId}`);
+        expect((created.measurementConfiguration as any).externalId).toBeTruthy();
+        expect((created.measurementConfiguration as any).ingestion).toContain('ingest-bucket/biz-2/');
+        expect((created.measurementConfiguration as any).dlq).toContain('dlq-bucket/biz-2/');
+        expect((created.measurementConfiguration as any).region).toBe('us-east-1');
+        expect(iamCalls.createRole).toHaveLength(1);
+        expect(loadPoints).toHaveBeenCalled();
+    });
+
+    it('defaults omitted platform and region', () => {
+        const defaults = new DatastoreAccessInformation({ accountId: '1', businessID: 'b' } as any);
+        expect(defaults.platform).toBe('s3');
+        expect(defaults.region).toBe('us-east-1');
+    });
+
+    it('orchestrates setupAccess and updateAccess through MeasurementConfigEntity helpers', async () => {
+        const setupSpy = jest.spyOn(DatastoreAccessInformation, 'setupAccess').mockResolvedValue({} as any);
+        const updateSpy = jest.spyOn(DatastoreAccessInformation, 'updateAccess').mockResolvedValue({} as any);
+        const entity = new MeasurementConfigEntity({
+            measurementId: 'm1',
+            measurementMode: measurementMode.datastoreBased,
+            measurementConfiguration: { accountId: '1' } as any,
+            businessID: 'b1',
+            subject: 's',
+            measurementName: 'n',
+        } as any);
+        await MeasurementConfigEntity.setupAccessIfRequired(entity);
+        await MeasurementConfigEntity.updateAccessIfRequired(entity);
+        expect(setupSpy).toHaveBeenCalled();
+        expect(updateSpy).toHaveBeenCalled();
+    });
+});
