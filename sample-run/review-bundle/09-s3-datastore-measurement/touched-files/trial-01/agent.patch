+import { S3 } from '@aws-sdk/client-s3';
+import { PrivateAPIUsageController } from './usage.controller';
+import { UsageService } from './usage.service';
+import { StandardMeasurementEntity } from '../measurement-config/entities/standardMeasurement.entity';
+
+jest.mock('@aws-sdk/client-s3', () => {
+    const putObject = jest.fn().mockResolvedValue({});
+    const S3 = jest.fn().mockImplementation(() => ({ putObject }));
+    return { S3, __mocks: { putObject } };
+});
+
+const { __mocks: s3Mocks } = jest.requireMock('@aws-sdk/client-s3');
+
+describe('PrivateAPIUsageController.dbUsage', () => {
+    const originalEnv = process.env;
+    let usageService: { create: jest.Mock };
+    let controller: PrivateAPIUsageController;
+
+    beforeEach(() => {
+        process.env = {
+            ...originalEnv,
+            DB_MEASUREMENT_DLQ_BUCKET_NAME: 'meteringco-usage-dlq',
+            AWS_REGION: 'us-east-1',
+        };
+        s3Mocks.putObject.mockClear();
+        usageService = { create: jest.fn().mockResolvedValue({ message: 'Measurement created' }) };
+        controller = new PrivateAPIUsageController(usageService as unknown as UsageService);
+    });
+
+    afterAll(() => {
+        process.env = originalEnv;
+    });
+
+    it('sends valid records through UsageService.create with business ID from s3Key', async () => {
+        const record = {
+            dimensionId: 'dim-1',
+            recordValue: '1.5',
+            timeStamp: '2024-01-01T00:00:00Z',
+            serviceId: 'svc-1',
+        };
+        await controller.dbUsage({
+            message: JSON.stringify(record),
+            s3Key: 'biz-123/folder/record.json',
+        });
+        expect(usageService.create).toHaveBeenCalledWith({ ...record, businessID: 'biz-123' });
+        expect(s3Mocks.putObject).not.toHaveBeenCalled();
+    });
+
+    it('writes malformed records to the DLQ using the mirrored source key', async () => {
+        await expect(
+            controller.dbUsage({
+                message: 'not-json',
+                s3Key: 'biz-123/folder/record.json',
+            })
+        ).resolves.toEqual({ message: 'Failed to process usage record' });
+        expect(usageService.create).not.toHaveBeenCalled();
+        expect(s3Mocks.putObject).toHaveBeenCalledTimes(1);
+        const put = s3Mocks.putObject.mock.calls[0][0];
+        expect(put.Bucket).toBe('meteringco-usage-dlq');
+        expect(put.Key).toBe('biz-123/folder/record.json.message.text');
+        const body = JSON.parse(put.Body);
+        expect(body.failedInput).toBe('not-json');
+        expect(body.processingMetadata.businessID).toBe('biz-123');
+        expect(body.processingMetadata.sourceKey).toBe('biz-123/folder/record.json');
+    });
+
+    it('supports already-relative source keys and s3 URIs', async () => {
+        await StandardMeasurementEntity.publishFailureToDLQ({
+            sourceKey: 'biz-123/rel/file.json',
+            input: { bad: true },
+            error: new Error('nope'),
+            businessID: 'biz-123',
+        });
+        expect(s3Mocks.putObject.mock.calls[0][0].Key).toBe('biz-123/rel/file.json.message.text');
+
+        s3Mocks.putObject.mockClear();
+        await StandardMeasurementEntity.publishFailureToDLQ({
+            sourceKey: 's3://other-bucket/biz-123/abs/file.json',
+            input: 'broken',
+            error: new Error('nope'),
+            businessID: 'biz-123',
+        });
+        expect(s3Mocks.putObject.mock.calls[0][0].Key).toBe('biz-123/abs/file.json.message.text');
+    });
+});
