@@ -0,0 +1,108 @@
+import { IAM } from '@aws-sdk/client-iam';
+import { DatastoreAccessInformation, SupportedDatastores } from './measurement-config.entity';
+
+jest.mock('@aws-sdk/client-iam', () => {
+    const createRole = jest.fn();
+    const putRolePolicy = jest.fn();
+    const updateAssumeRolePolicy = jest.fn();
+    const getRole = jest.fn();
+    const IAM = jest.fn().mockImplementation(() => ({
+        createRole,
+        putRolePolicy,
+        updateAssumeRolePolicy,
+        getRole,
+    }));
+    return { IAM, __mocks: { createRole, putRolePolicy, updateAssumeRolePolicy, getRole } };
+});
+
+const { __mocks: iamMocks } = jest.requireMock('@aws-sdk/client-iam');
+
+describe('DatastoreAccessInformation', () => {
+    const originalEnv = process.env;
+
+    beforeEach(() => {
+        process.env = {
+            ...originalEnv,
+            DB_MEASUREMENT_BUCKET_NAME: 'meteringco-usage-ingest',
+            DB_MEASUREMENT_DLQ_BUCKET_NAME: 'meteringco-usage-dlq',
+            AWS_REGION: 'us-east-1',
+        };
+        iamMocks.createRole.mockReset().mockResolvedValue({
+            Role: { Arn: 'arn:aws:iam::999999999999:role/datastore-biz-mid' },
+        });
+        iamMocks.putRolePolicy.mockReset().mockResolvedValue({});
+        iamMocks.updateAssumeRolePolicy.mockReset().mockResolvedValue({});
+        iamMocks.getRole.mockReset().mockResolvedValue({
+            Role: { Arn: 'arn:aws:iam::999999999999:role/datastore-biz-mid' },
+        });
+        (IAM as unknown as jest.Mock).mockClear();
+    });
+
+    afterAll(() => {
+        process.env = originalEnv;
+    });
+
+    it('defaults omitted platform and region', () => {
+        const info = new DatastoreAccessInformation({ accountId: '111122223333' } as DatastoreAccessInformation);
+        expect(info.platform).toBe(SupportedDatastores.s3);
+        expect(info.region).toBe('us-east-1');
+        expect(info.accountId).toBe('111122223333');
+    });
+
+    it('provisions a uniquely named IAM role and prefix-scoped policy', async () => {
+        const info = new DatastoreAccessInformation({
+            platform: 's3',
+            accountId: '111122223333',
+            businessID: 'biz',
+            measurementId: 'mid',
+        } as DatastoreAccessInformation);
+
+        await DatastoreAccessInformation.setupAccess(info);
+
+        expect(IAM).toHaveBeenCalledWith({ region: 'us-east-1' });
+        expect(iamMocks.createRole).toHaveBeenCalledTimes(1);
+        const createInput = iamMocks.createRole.mock.calls[0][0];
+        expect(createInput.RoleName).toBe('datastore-biz-mid');
+        const trust = JSON.parse(createInput.AssumeRolePolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::111122223333:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe(info.externalId);
+
+        const policyInput = iamMocks.putRolePolicy.mock.calls[0][0];
+        expect(policyInput.RoleName).toBe('datastore-biz-mid');
+        const policy = JSON.parse(policyInput.PolicyDocument);
+        const resources = JSON.stringify(policy);
+        expect(resources).toContain('arn:aws:s3:::meteringco-usage-ingest/biz/*');
+        expect(resources).toContain('arn:aws:s3:::meteringco-usage-dlq/biz/*');
+
+        expect(info.iamRoleArn).toBe('arn:aws:iam::999999999999:role/datastore-biz-mid');
+        expect(info.externalId).toBeTruthy();
+        expect(info.ingestion).toBe('s3://meteringco-usage-ingest/biz/');
+        expect(info.dlq).toBe('s3://meteringco-usage-dlq/biz/');
+        expect(info.region).toBe('us-east-1');
+        expect(info.platform).toBe('s3');
+    });
+
+    it('updates role trust while preserving role and external ID', async () => {
+        const info = new DatastoreAccessInformation({
+            platform: 's3',
+            accountId: '444455556666',
+            businessID: 'biz',
+            measurementId: 'mid',
+            iamRoleArn: 'arn:aws:iam::999999999999:role/datastore-biz-mid',
+            externalId: 'keep-me',
+            region: 'us-east-1',
+        } as DatastoreAccessInformation);
+
+        await DatastoreAccessInformation.updateAccess(info);
+
+        expect(iamMocks.updateAssumeRolePolicy).toHaveBeenCalledTimes(1);
+        const updateInput = iamMocks.updateAssumeRolePolicy.mock.calls[0][0];
+        expect(updateInput.RoleName).toBe('datastore-biz-mid');
+        const trust = JSON.parse(updateInput.PolicyDocument);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::444455556666:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe('keep-me');
+        expect(info.iamRoleArn).toBe('arn:aws:iam::999999999999:role/datastore-biz-mid');
+        expect(info.externalId).toBe('keep-me');
+        expect(iamMocks.createRole).not.toHaveBeenCalled();
+    });
+});
