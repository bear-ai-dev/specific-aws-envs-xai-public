+
+    /**
+     * Write a failed S3 ingestion record to the configured DLQ bucket.
+     * The destination key mirrors the source key and appends `.message.text`.
+     */
+    static async publishFailureToDLQ(
+        sourceKeyOrPayload?: any,
+        input?: unknown,
+        error?: unknown,
+        metadata?: Record<string, unknown>
+    ) {
+        const payload =
+            sourceKeyOrPayload && typeof sourceKeyOrPayload === 'object'
+                ? sourceKeyOrPayload
+                : {
+                      sourceKey: sourceKeyOrPayload,
+                      input,
+                      error,
+                      metadata,
+                  };
+        const bucket = process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME;
+        if (!bucket) {
+            return;
+        }
+
+        const rawKey = payload.sourceKey || payload.s3Key || '';
+        const relativeKey = String(rawKey)
+            .replace(/^s3:\/\/[^/]+\//, '')
+            .replace(/^\/+/, '');
+        const dlqKey = `${relativeKey || 'unknown'}.message.text`;
+        const originalInput = payload.failedInput !== undefined ? payload.failedInput : payload.input;
+        const failedInput =
+            typeof originalInput === 'string'
+                ? originalInput
+                : originalInput === undefined
+                ? ''
+                : (() => {
+                      try {
+                          return JSON.stringify(originalInput);
+                      } catch {
+                          return String(originalInput);
+                      }
+                  })();
+        const caught = payload.error !== undefined ? payload.error : error;
+        const errorMessage =
+            caught instanceof Error
+                ? caught.message
+                : caught === undefined
+                ? 'Unknown processing error'
+                : String(caught);
+        const body = JSON.stringify({
+            failedInput,
+            input: originalInput,
+            error: {
+                message: errorMessage,
+                name: caught instanceof Error ? caught.name : undefined,
+                stack: caught instanceof Error ? caught.stack : undefined,
+            },
+            processingMetadata: {
+                businessID: payload.businessID,
+                sourceKey: relativeKey || rawKey,
+                processedAt: new Date().toISOString(),
+                ...(payload.metadata || {}),
+                ...(payload.processingMetadata || {}),
+                ...(metadata || {}),
+            },
+        });
+
+        const s3 = new S3({ region: process.env.AWS_REGION || 'us-east-1' });
+        await s3.putObject({
+            Bucket: bucket,
+            Key: dlqKey,
+            Body: body,
+            ContentType: 'text/plain',
+        });
+    }
 }
