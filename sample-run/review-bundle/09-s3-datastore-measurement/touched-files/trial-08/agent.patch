diff --git a/src/usage/usage.dbUsage.spec.ts b/src/usage/usage.dbUsage.spec.ts
new file mode 100644
index 0000000..cea8491
--- /dev/null
+++ b/src/usage/usage.dbUsage.spec.ts
@@ -0,0 +1,69 @@
+const putObject = jest.fn();
+
+jest.mock('@aws-sdk/client-s3', () => ({
+    S3: jest.fn().mockImplementation(() => ({
+        putObject,
+    })),
+}));
+
+import { PrivateAPIUsageController } from './usage.controller';
+import { UsageService } from './usage.service';
+import { StandardMeasurementEntity } from '../measurement-config/entities/standardMeasurement.entity';
+
+describe('PrivateAPIUsageController.dbUsage', () => {
+    const create = jest.fn();
+    const controller = new PrivateAPIUsageController({ create } as unknown as UsageService);
+
+    beforeEach(() => {
+        create.mockReset();
+        putObject.mockReset();
+        process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME = 'meteringco-usage-record-dlq-bucket';
+        process.env.AWS_REGION = 'us-east-1';
+    });
+
+    it('passes parsed record to UsageService.create with business ID from s3Key', async () => {
+        create.mockResolvedValue({ message: 'Measurement created' });
+        const record = {
+            timeStamp: '2023-02-08T19:24:10Z',
+            dimensionId: 'dim-1',
+            recordValue: '1',
+        };
+        await controller.dbUsage({
+            message: JSON.stringify(record),
+            s3Key: 'biz-42/path/to/object.json',
+        });
+        expect(create).toHaveBeenCalledWith({ ...record, businessID: 'biz-42' });
+    });
+
+    it('writes malformed records to the DLQ under mirrored source key plus .message.text', async () => {
+        putObject.mockResolvedValue({});
+        await controller.dbUsage({
+            message: 'not-json',
+            s3Key: 'biz-42/path/to/object.json',
+        });
+        expect(create).not.toHaveBeenCalled();
+        expect(putObject).toHaveBeenCalledWith(
+            expect.objectContaining({
+                Bucket: 'meteringco-usage-record-dlq-bucket',
+                Key: 'biz-42/path/to/object.json.message.text',
+            })
+        );
+        const body = JSON.parse(putObject.mock.calls[0][0].Body as string);
+        expect(body.failedInput || body.input.message).toBe('not-json');
+        expect(body.processingMetadata).toBeDefined();
+    });
+
+    it('supports already-relative source keys and s3 URIs', async () => {
+        putObject.mockResolvedValue({});
+        await StandardMeasurementEntity.publishFailureToDLQ({
+            message: { bad: true },
+            s3Key: 's3://meteringco-usage-record-dump-bucket/biz-42/rel.json',
+            error: new Error('boom'),
+        });
+        expect(putObject).toHaveBeenCalledWith(
+            expect.objectContaining({
+                Key: 'biz-42/rel.json.message.text',
+            })
+        );
+    });
+});
