+                const externalId = uuidv4();
+                const iam = new IAM({ region: process.env.AWS_REGION || region });
+                const trustPolicy = DatastoreAccessInformation.buildTrustPolicy(resolvedAccountId, externalId);
+                const createRoleResponse = await iam.createRole({
