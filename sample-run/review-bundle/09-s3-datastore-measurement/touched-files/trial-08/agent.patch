+        error?: unknown;
+        metadata?: Record<string, unknown>;
+    }) {
+        const relativeKey = StandardMeasurementEntity.toRelativeS3Key(s3Key);
+        const dlqKey = relativeKey ? `${relativeKey}.message.text` : `unknown/${randomUUID()}.message.text`;
+        const err = error as { message?: string; name?: string; stack?: string; Code?: string };
+        const payload = {
+            input: { message, s3Key },
+            failedInput: message,
+            processingMetadata: {
+                s3Key,
+                relativeKey,
+                failedAt: new Date().toISOString(),
+                error: {
+                    message: err?.message || String(error),
+                    name: err?.name,
+                    stack: err?.stack,
+                    code: err?.Code,
+                },
+                ...metadata,
+            },
+        };
+        const s3 = new S3({ region: process.env.AWS_REGION || 'us-east-1' });
+        await s3.putObject({
+            Bucket: process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME,
+            Key: dlqKey,
+            Body: typeof payload === 'string' ? payload : JSON.stringify(payload),
+            ContentType: 'text/plain',
+        });
+        return { key: dlqKey, bucket: process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME };
+    }
 }
