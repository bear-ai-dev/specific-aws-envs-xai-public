+++ b/src/measurement-config/entities/datastore-access.entity.spec.ts
@@ -0,0 +1,102 @@
+const createRole = jest.fn();
+const putRolePolicy = jest.fn();
+const updateAssumeRolePolicy = jest.fn();
+
+jest.mock('@aws-sdk/client-iam', () => ({
+    IAM: jest.fn().mockImplementation(() => ({
+        createRole,
+        putRolePolicy,
+        updateAssumeRolePolicy,
+    })),
+}));
+
+import { DatastoreAccessInformation, SupportedDatastores } from './measurement-config.entity';
+
+describe('DatastoreAccessInformation', () => {
+    beforeEach(() => {
+        process.env.DB_MEASUREMENT_BUCKET_NAME = 'meteringco-usage-record-dump-bucket';
+        process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME = 'meteringco-usage-record-dlq-bucket';
+        process.env.AWS_REGION = 'us-east-1';
+        createRole.mockReset();
+        putRolePolicy.mockReset();
+        updateAssumeRolePolicy.mockReset();
+    });
+
+    it('defaults omitted platform and region', () => {
+        const access = new DatastoreAccessInformation({
+            accountId: '111122223333',
+            businessID: 'biz-1',
+        } as DatastoreAccessInformation);
+        expect(access.platform).toBe(SupportedDatastores.s3);
+        expect(access.region).toBe('us-east-1');
+        expect(access.accountId).toBe('111122223333');
+    });
+
+    it('setupAccess provisions a uniquely named IAM role and policy', async () => {
+        createRole.mockResolvedValue({
+            Role: { Arn: 'arn:aws:iam::9999:role/datastore-biz-1-meas-1' },
+        });
+        putRolePolicy.mockResolvedValue({});
+
+        const access = new DatastoreAccessInformation({
+            accountId: '111122223333',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+        } as DatastoreAccessInformation);
+
+        await DatastoreAccessInformation.setupAccess(access);
+
+        expect(access.iamRoleArn).toBe('arn:aws:iam::9999:role/datastore-biz-1-meas-1');
+        expect(access.externalId).toBeTruthy();
+        expect(access.ingestion).toBe('s3://meteringco-usage-record-dump-bucket/biz-1/');
+        expect(access.dlq).toBe('s3://meteringco-usage-record-dlq-bucket/biz-1/');
+        expect(access.region).toBe('us-east-1');
+        expect(access.platform).toBe('s3');
+
+        expect(createRole).toHaveBeenCalledWith(
+            expect.objectContaining({
+                RoleName: 'datastore-biz-1-meas-1',
+            })
+        );
+        const trust = JSON.parse(createRole.mock.calls[0][0].AssumeRolePolicyDocument as string);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::111122223333:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe(access.externalId);
+
+        const policy = JSON.parse(putRolePolicy.mock.calls[0][0].PolicyDocument as string);
+        const resources = policy.Statement.flatMap((s) => s.Resource);
+        expect(resources).toEqual(
+            expect.arrayContaining([
+                'arn:aws:s3:::meteringco-usage-record-dump-bucket/biz-1/*',
+                'arn:aws:s3:::meteringco-usage-record-dlq-bucket/biz-1/*',
+            ])
+        );
+    });
+
+    it('updateAccess updates role trust while preserving role and external ID', async () => {
+        updateAssumeRolePolicy.mockResolvedValue({});
+
+        const access = new DatastoreAccessInformation({
+            accountId: '444455556666',
+            businessID: 'biz-1',
+            measurementId: 'meas-1',
+            iamRoleArn: 'arn:aws:iam::9999:role/datastore-biz-1-meas-1',
+            externalId: 'keep-me',
+            platform: SupportedDatastores.s3,
+            region: 'us-east-1',
+        } as DatastoreAccessInformation);
+
+        await DatastoreAccessInformation.updateAccess(access);
+
+        expect(access.iamRoleArn).toBe('arn:aws:iam::9999:role/datastore-biz-1-meas-1');
+        expect(access.externalId).toBe('keep-me');
+        expect(updateAssumeRolePolicy).toHaveBeenCalledWith(
+            expect.objectContaining({
+                RoleName: 'datastore-biz-1-meas-1',
+            })
+        );
+        const trust = JSON.parse(updateAssumeRolePolicy.mock.calls[0][0].PolicyDocument as string);
+        expect(trust.Statement[0].Principal.AWS).toBe('arn:aws:iam::444455556666:root');
+        expect(trust.Statement[0].Condition.StringEquals['sts:ExternalId']).toBe('keep-me');
+        expect(createRole).not.toHaveBeenCalled();
+    });
+});
