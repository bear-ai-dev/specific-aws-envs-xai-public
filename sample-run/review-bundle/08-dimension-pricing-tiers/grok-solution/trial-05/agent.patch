index 0000000..df8fee6
--- /dev/null
+++ b/src/dimensions/dto/tiers.util.ts
@@ -0,0 +1,141 @@
+import { UsageDimensionTier } from './usage-dimension-tier.dto.js';
+
+export const INFINITE_TIER_BOUND = 'inf';
+
+export type AllocatedTier = {
+    tier: UsageDimensionTier;
+    rawQuantity: number;
+    unitPrice: string;
+};
+
+const isNumericString = (value?: string): boolean => {
+    if (value === undefined || value === null || value === '') {
+        return false;
+    }
+    return !isNaN(value as unknown as number) && !isNaN(parseFloat(value));
+};
+
+export const parseTierBound = (upperBound: string): number => {
+    if (upperBound === INFINITE_TIER_BOUND) {
+        return Number.POSITIVE_INFINITY;
+    }
+    return parseFloat(upperBound);
+};
+
+export const sortTiersByPosition = (tiers: UsageDimensionTier[]): UsageDimensionTier[] => {
+    return [...tiers].sort((a, b) => parseFloat(a.tierPosition) - parseFloat(b.tierPosition));
+};
+
+export const isMultipleOfIncrement = (value: number, usageIncrement: number): boolean => {
+    if (!Number.isFinite(value) || !usageIncrement) {
+        return true;
+    }
+    const remainder = Math.abs(value / usageIncrement - Math.round(value / usageIncrement));
+    return remainder < 1e-8;
+};
+
+export const validateDimensionTiers = (
+    tiers: UsageDimensionTier[] | null | undefined,
+    usageIncrement?: string | number,
+): string | null => {
+    if (tiers === undefined || tiers === null) {
+        return null;
+    }
+    if (!Array.isArray(tiers)) {
+        return 'tiers must be an array';
+    }
+    if (tiers.length === 0) {
+        return 'tiers must contain at least one tier';
+    }
+
+    const seenPositions = new Set<string>();
+    for (const [index, tier] of tiers.entries()) {
+        if (!tier || typeof tier !== 'object') {
+            return `tiers[${index}] must be an object`;
+        }
+        if (!isNumericString(tier.tierPosition)) {
+            return `tiers[${index}].tierPosition must be a numeric string`;
+        }
+        if (seenPositions.has(tier.tierPosition)) {
+            return `tiers[${index}].tierPosition must be unique`;
+        }
+        seenPositions.add(tier.tierPosition);
+
+        if (tier.upperBound === undefined || tier.upperBound === null || tier.upperBound === '') {
+            return `tiers[${index}].upperBound is required`;
+        }
+        if (tier.upperBound !== INFINITE_TIER_BOUND && !isNumericString(tier.upperBound)) {
+            return `tiers[${index}].upperBound must be a numeric string or "inf"`;
+        }
+        if (tier.unitPrice !== undefined && tier.unitPrice !== null && !isNumericString(tier.unitPrice)) {
+            return `tiers[${index}].unitPrice must be a numeric string`;
+        }
+    }
+
+    const sorted = sortTiersByPosition(tiers);
+    const increment =
+        usageIncrement !== undefined && usageIncrement !== null && usageIncrement !== ''
+            ? Number(usageIncrement)
+            : undefined;
+
+    let previousBound = 0;
+    for (const [index, tier] of sorted.entries()) {
+        if (index > 0 && (tier.unitPrice === undefined || tier.unitPrice === null || tier.unitPrice === '')) {
+            return `Every tier after the first requires unitPrice`;
+        }
+        const bound = parseTierBound(tier.upperBound);
+        if (tier.upperBound === INFINITE_TIER_BOUND && index !== sorted.length - 1) {
+            return `"inf" upperBound is only allowed on the last tier`;
+        }
+        if (tier.upperBound !== INFINITE_TIER_BOUND && !(bound > previousBound)) {
+            return `Tier upperBound values must increase without overlap`;
+        }
+        if (increment !== undefined && !Number.isNaN(increment) && tier.upperBound !== INFINITE_TIER_BOUND) {
+            if (!isMultipleOfIncrement(bound, increment)) {
+                return `Tier upperBound values must align to usageIncrement`;
+            }
+        }
+        if (Number.isFinite(bound)) {
+            previousBound = bound;
+        }
+    }
+
+    return null;
+};
+
+export const allocateUsageAcrossTiers = (totalUsage: number, tiers: UsageDimensionTier[]): AllocatedTier[] => {
+    if (!Array.isArray(tiers) || tiers.length === 0 || !totalUsage || totalUsage <= 0) {
+        return [];
+    }
+
+    const sorted = sortTiersByPosition(tiers);
+    const allocated: AllocatedTier[] = [];
+    let previousBound = 0;
+    let remaining = totalUsage;
+
+    for (const tier of sorted) {
+        if (remaining <= 0) {
+            break;
+        }
+        const bound = parseTierBound(tier.upperBound);
+        const capacity = Number.isFinite(bound) ? bound - previousBound : remaining;
+        if (capacity <= 0) {
+            previousBound = Number.isFinite(bound) ? bound : previousBound;
+            continue;
+        }
+        const rawQuantity = Math.min(remaining, capacity);
+        if (rawQuantity > 0) {
+            allocated.push({
+                tier,
+                rawQuantity,
+                unitPrice: tier.unitPrice ?? '0',
+            });
+            remaining -= rawQuantity;
+        }
+        if (Number.isFinite(bound)) {
+            previousBound = bound;
+        }
+    }
+
+    return allocated;
+};
