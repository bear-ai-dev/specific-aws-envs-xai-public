+import { allocateUsageAcrossTiers, validateDimensionTiers } from './tiers.util.js';
+
+describe('tiers.util', () => {
+    const validTiers = [
+        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.05', tierName: 'High volume' },
+        { tierPosition: '1', upperBound: '1000', unitPrice: '0.10', tierName: 'First 1000' },
+    ];
+
+    it('accepts increasing inclusive bounds that align to usageIncrement', () => {
+        expect(validateDimensionTiers(validTiers, '1')).toBeNull();
+        expect(validateDimensionTiers([{ tierPosition: '1', upperBound: '10' }], '1')).toBeNull();
+    });
+
+    it('rejects overlapping, non-aligned, or mid-list inf bounds', () => {
+        expect(
+            validateDimensionTiers(
+                [
+                    { tierPosition: '1', upperBound: '100', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: '50', unitPrice: '2' },
+                ],
+                '1',
+            ),
+        ).toEqual('Tier upperBound values must increase without overlap');
+        expect(
+            validateDimensionTiers(
+                [
+                    { tierPosition: '1', upperBound: '15', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '2' },
+                ],
+                '10',
+            ),
+        ).toEqual('Tier upperBound values must align to usageIncrement');
+        expect(
+            validateDimensionTiers(
+                [
+                    { tierPosition: '1', upperBound: 'inf', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: '20', unitPrice: '2' },
+                ],
+                '1',
+            ),
+        ).toEqual('"inf" upperBound is only allowed on the last tier');
+        expect(
+            validateDimensionTiers(
+                [
+                    { tierPosition: '1', upperBound: '10' },
+                    { tierPosition: '2', upperBound: 'inf' },
+                ],
+                '1',
+            ),
+        ).toEqual('Every tier after the first requires unitPrice');
+    });
+
+    it('allocates inclusive usage by numeric tierPosition and treats a missing first price as free', () => {
+        const allocated = allocateUsageAcrossTiers(1500, validTiers);
+        expect(allocated).toEqual([
+            expect.objectContaining({
+                rawQuantity: 1000,
+                unitPrice: '0.10',
+                tier: expect.objectContaining({ tierPosition: '1', tierName: 'First 1000' }),
+            }),
+            expect.objectContaining({
+                rawQuantity: 500,
+                unitPrice: '0.05',
+                tier: expect.objectContaining({ tierPosition: '2', tierName: 'High volume' }),
+            }),
+        ]);
+
+        const freeFirst = allocateUsageAcrossTiers(25, [
+            { tierPosition: '1', upperBound: '10' },
+            { tierPosition: '2', upperBound: 'inf', unitPrice: '3' },
+        ]);
+        expect(freeFirst[0].unitPrice).toEqual('0');
+        expect(freeFirst[0].rawQuantity).toEqual(10);
+        expect(freeFirst[1].rawQuantity).toEqual(15);
+    });
+});
diff --git a/src/dimensions/dto/tiers.util.ts b/src/dimensions/dto/tiers.util.ts
