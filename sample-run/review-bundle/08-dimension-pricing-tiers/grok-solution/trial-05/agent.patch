+@ValidatorConstraint({ name: 'TiersAreMutuallyExclusive', async: false })
+@Injectable()
+export class TiersAreMutuallyExclusiveRule implements ValidatorConstraintInterface {
+    validate(tiers: CreateDimensionDto['tiers'], args: ValidationArguments) {
+        if (tiers === undefined || tiers === null) {
+            return true;
+        }
