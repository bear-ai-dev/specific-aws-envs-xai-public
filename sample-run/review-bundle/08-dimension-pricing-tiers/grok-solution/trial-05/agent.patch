@@ -0,0 +1,65 @@
+import { ApiProperty } from '@nestjs/swagger';
+import { IsNotEmpty, IsNumberString, IsOptional, IsString } from 'class-validator';
+import { ValidateDecimalPlace } from './validateDecimalPlaces.js';
+
+export class UsageDimensionTier {
+    /**
+     * The position of this tier in the volume ladder.
+     * Numerical values are represented as strings to avoid precision loss.
+     */
+    @IsNumberString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'tierPosition',
+        example: '1',
+        type: String,
+        required: true,
+        description: 'The position of this tier in the volume ladder.',
+    })
+    public tierPosition: string;
+
+    /**
+     * Inclusive upper bound for this tier. Use "inf" for the last, unbounded tier.
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'upperBound',
+        example: '1000',
+        type: String,
+        required: true,
+        description: 'Inclusive upper bound for this tier. Use "inf" for the last, unbounded tier.',
+    })
+    public upperBound: string;
+
+    /**
+     * Optional display name appended to the invoice line item.
+     */
+    @IsOptional()
+    @IsString()
+    @ApiProperty({
+        name: 'tierName',
+        example: 'Tier 1',
+        type: String,
+        required: false,
+        description: 'Optional display name appended to the invoice line item.',
+    })
+    public tierName?: string;
+
+    /**
+     * Unit price for usage allocated to this tier.
+     * Required on every tier after the first. An omitted first-tier price represents a free tier.
+     */
+    @IsOptional()
+    @IsNumberString()
+    @ValidateDecimalPlace('unitPrice')
+    @ApiProperty({
+        name: 'unitPrice',
+        example: '0.10',
+        type: String,
+        required: false,
+        description:
+            'Unit price for usage allocated to this tier. Required on every tier after the first. An omitted first-tier price represents a free tier.',
+    })
+    public unitPrice?: string;
+}
