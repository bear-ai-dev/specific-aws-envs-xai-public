+import { validate } from 'class-validator';
+import { plainToInstance } from 'class-transformer';
+import { aggregationMethod, CreateDimensionDto, roundingEnum } from './create-dimension.dto.js';
+
+const baseDimension = {
+    dimensionName: 'API Call',
+    usageIncrement: '10',
+    rounding: roundingEnum.ceiling,
+    consumptionUnit: { type: 'count', unit: 'count-based' },
+    aggregationMethod: aggregationMethod.sum,
+};
+
+describe('CreateDimensionDto tiers validation', () => {
+    it('accepts a valid tiered dimension without consumptionPrice', async () => {
+        const dto = plainToInstance(CreateDimensionDto, {
+            ...baseDimension,
+            tiers: [
+                { tierPosition: '1', upperBound: '100', tierName: 'Free' },
+                { tierPosition: '2', upperBound: 'inf', unitPrice: '0.25' },
+            ],
+        });
+        expect(await validate(dto)).toEqual([]);
+    });
+
+    it('rejects tiers combined with consumptionPrice, entitlement, or overageAllowed true', async () => {
+        const withPrice = plainToInstance(CreateDimensionDto, {
+            ...baseDimension,
+            consumptionPrice: '1.00',
+            tiers: [{ tierPosition: '1', upperBound: 'inf', unitPrice: '1.00' }],
+        });
+        expect((await validate(withPrice)).length).toBeGreaterThan(0);
+
+        const withEntitlement = plainToInstance(CreateDimensionDto, {
+            ...baseDimension,
+            usageEntitlement: 10,
+            overageAllowed: 'false',
+            tiers: [{ tierPosition: '1', upperBound: 'inf', unitPrice: '1.00' }],
+        });
+        expect((await validate(withEntitlement)).length).toBeGreaterThan(0);
+
+        const withOverage = plainToInstance(CreateDimensionDto, {
+            ...baseDimension,
+            overageAllowed: 'true',
+            usageEntitlement: 10,
+            consumptionPrice: '1.00',
+            tiers: [{ tierPosition: '1', upperBound: 'inf', unitPrice: '1.00' }],
+        });
+        expect((await validate(withOverage)).length).toBeGreaterThan(0);
+    });
+});
