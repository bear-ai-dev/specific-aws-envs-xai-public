+            target: object.constructor,
+            propertyName: propertyName,
+            constraints: [property],
+            options: validationOptions,
+            validator: TiersAreMutuallyExclusiveRule,
+        });
+    };
+}
+
+@ValidatorConstraint({ name: 'ValidateTiers', async: false })
+@Injectable()
+export class ValidateTiersRule implements ValidatorConstraintInterface {
+    validate(tiers: CreateDimensionDto['tiers'], args: ValidationArguments) {
+        if (tiers === undefined || tiers === null) {
+            return true;
+        }
+        const usageIncrement = (args.object as CreateDimensionDto)?.usageIncrement;
+        return validateDimensionTiers(tiers, usageIncrement) === null;
+    }
+
+    defaultMessage(args: ValidationArguments) {
+        const usageIncrement = (args.object as CreateDimensionDto)?.usageIncrement;
+        return validateDimensionTiers((args.object as CreateDimensionDto)?.tiers, usageIncrement) || 'Invalid tiers';
+    }
+}
+
+export function ValidateTiers(property: string, validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'ValidateTiers',
+            target: object.constructor,
+            propertyName: propertyName,
+            constraints: [property],
+            options: validationOptions,
+            validator: ValidateTiersRule,
+        });
+    };
+}
