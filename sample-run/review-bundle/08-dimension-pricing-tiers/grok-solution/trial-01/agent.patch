diff --git a/src/dimensions/dto/tierBilling.ts b/src/dimensions/dto/tierBilling.ts
new file mode 100644
index 0000000..f1738f9
--- /dev/null
+++ b/src/dimensions/dto/tierBilling.ts
@@ -0,0 +1,78 @@
+import { UsageTierDto } from './usage-tier.dto.js';
+
+export function isNumericString(value: unknown): value is string {
+    if (typeof value !== 'string' || value.trim() === '') {
+        return false;
+    }
+    return !isNaN(value as unknown as number) && !isNaN(parseFloat(value));
+}
+
+export function hasUsageTiers(tiers?: UsageTierDto[] | null): tiers is UsageTierDto[] {
+    return Array.isArray(tiers) && tiers.length > 0;
+}
+
+export function isUnpricedDimension({
+    tiers,
+    consumptionPrice,
+    usageEntitlement,
+}: {
+    tiers?: UsageTierDto[] | null;
+    consumptionPrice?: string | null;
+    usageEntitlement?: number | 'inf' | null;
+}): boolean {
+    return (
+        !hasUsageTiers(tiers) &&
+        (consumptionPrice === undefined || consumptionPrice === null || consumptionPrice === '') &&
+        (usageEntitlement === undefined || usageEntitlement === null)
+    );
+}
+
+export type AllocatedUsageTier = {
+    tier: UsageTierDto;
+    rawUsage: number;
+    quantity: number;
+};
+
+export function allocateUsageAcrossTiers({
+    totalUsage,
+    tiers,
+    usageIncrement,
+}: {
+    totalUsage: number;
+    tiers: UsageTierDto[];
+    usageIncrement: number;
+}): AllocatedUsageTier[] {
+    const increment = Number(usageIncrement) || 1;
+    const sorted = [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+    const allocations: AllocatedUsageTier[] = [];
+    let remaining = Number(totalUsage);
+    let previousBound = 0;
+
+    if (!Number.isFinite(remaining) || remaining <= 0) {
+        return allocations;
+    }
+
+    for (const tier of sorted) {
+        const currentBound = tier.upperBound === 'inf' ? Number.POSITIVE_INFINITY : Number(tier.upperBound);
+        const capacity = currentBound - previousBound;
+        if (!(capacity > 0)) {
+            previousBound = currentBound;
+            continue;
+        }
+        const consumed = Math.min(remaining, capacity);
+        if (consumed > 0) {
+            allocations.push({
+                tier,
+                rawUsage: consumed,
+                quantity: consumed / increment,
+            });
+            remaining -= consumed;
+        }
+        previousBound = currentBound;
+        if (remaining <= 0) {
+            break;
+        }
+    }
+
+    return allocations;
+}
