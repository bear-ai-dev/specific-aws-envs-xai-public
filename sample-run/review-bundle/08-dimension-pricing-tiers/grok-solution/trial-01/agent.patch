+import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';
+import { Type } from 'class-transformer';
+import { IsNotEmpty, IsOptional, IsString, ValidateNested } from 'class-validator';
+import { ValidateDecimalPlace } from './validateDecimalPlaces.js';
+
+export class UsageTierDto {
+    /**
+     * The position of this tier in the volume pricing ladder.
+     * Represented as a numeric string so callers can keep integer-like values
+     * without precision loss. Billing sorts by the numeric value of this field.
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'tierPosition',
+        type: String,
+        example: '1',
+        description: 'The position of this tier in the volume pricing ladder. Billing sorts by the numeric value.',
+    })
+    public tierPosition: string;
+
+    /**
+     * Inclusive upper bound of this tier. Either a numeric string or "inf".
+     * "inf" may only appear on the last tier.
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'upperBound',
+        oneOf: [
+            { type: 'string', description: 'A numeric string representing the inclusive upper bound of this tier.' },
+            { type: 'string', enum: ['inf'], description: 'No upper bound. May only appear on the last tier.' },
+        ],
+        example: '1000',
+        description: 'Inclusive upper bound of this tier. Either a numeric string or "inf".',
+    })
+    public upperBound: string;
+
+    /**
+     * Optional display name appended to the invoice line item for this tier.
+     */
+    @IsOptional()
+    @IsString()
+    @ApiPropertyOptional({
+        name: 'tierName',
+        type: String,
+        example: 'Free tier',
+        description: 'Optional display name appended to the invoice line item for this tier.',
+    })
+    public tierName?: string;
+
+    /**
+     * Unit price for usage that falls into this tier.
+     * Required for every tier after the first. An omitted first-tier price represents a free tier.
+     */
+    @IsOptional()
+    @IsString()
+    @ValidateDecimalPlace('unitPrice')
+    @ApiPropertyOptional({
+        name: 'unitPrice',
+        type: String,
+        example: '0.05',
+        description:
+            'Unit price for usage that falls into this tier. Required for every tier after the first. An omitted first-tier price represents a free tier.',
+    })
+    public unitPrice?: string;
+}
+
+export class UsageTiersDto {
+    @ValidateNested({ each: true })
+    @Type(() => UsageTierDto)
+    public tiers: UsageTierDto[];
+}
