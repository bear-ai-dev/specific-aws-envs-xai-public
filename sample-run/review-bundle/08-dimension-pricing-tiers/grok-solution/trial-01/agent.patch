+import { CreateDimensionDto, roundingEnum, countBasedUnits } from './dto/create-dimension.dto.js';
+import { DimensionEntity, numericalType } from './entities/dimensions.entity.js';
+import { DimensionsService } from './dimensions.service.js';
+
+describe('Dimension usage tiers persistence', () => {
+    const service = Object.create(DimensionsService.prototype) as DimensionsService;
+    const baseDto = {
+        dimensionName: 'API Calls',
+        usageIncrement: '10',
+        rounding: roundingEnum.ceiling,
+        consumptionUnit: {
+            unit: countBasedUnits['count-based'],
+            type: 'count' as const,
+        },
+        businessID: 'biz',
+    };
+
+    const tiers = [
+        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02', tierName: 'High volume' },
+        { tierPosition: '1', upperBound: '100', unitPrice: '0.05', tierName: 'Low volume' },
+    ];
+
+    it('persists supplied tiers and returns the same objects on read', () => {
+        const input = service.transformDtoToEntityInput(
+            {
+                ...baseDto,
+                tiers,
+            } as CreateDimensionDto,
+            'dim-1',
+        );
+        expect(input.numerical.tiers).toEqual(tiers);
+
+        const entity = new DimensionEntity(input);
+        const dto = new CreateDimensionDto(entity);
+        expect(dto.tiers).toEqual(tiers);
+        expect(dto.consumptionPrice).toBeUndefined();
+    });
+
+    it('replaces existing tiers when a new array is provided', () => {
+        const replacement = [{ tierPosition: '1', upperBound: 'inf', unitPrice: '1.00' }];
+        const input = service.transformDtoToEntityInput(
+            {
+                ...baseDto,
+                tiers: replacement,
+            } as CreateDimensionDto,
+            'dim-1',
+        );
+        expect(input.numerical.tiers).toEqual(replacement);
+    });
+
+    it('clears tiers when tiers is null', () => {
+        const input = service.transformDtoToEntityInput(
+            {
+                ...baseDto,
+                consumptionPrice: '2.00',
+                tiers: null,
+            } as CreateDimensionDto,
+            'dim-1',
+        );
+        expect(input.numerical.tiers).toBeUndefined();
+        expect(input.numerical.priceSegments).toEqual([
+            {
+                lowerLimit: '0',
+                upperLimit: 'inf',
+                price: '2.00',
+            },
+        ]);
+    });
+});
