+import { allocateUsageAcrossTiers, validateDimensionTiers } from './tierValidator.js';
+describe('validateDimensionTiers', () => {
+    const validTiers = [
+        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02', tierName: 'High volume' },
+        { tierPosition: '1', upperBound: '1000', unitPrice: '0.05', tierName: 'Low volume' },
+    ];
+
+    it('accepts omitted tiers', () => {
+        expect(validateDimensionTiers({})).toBeNull();
+    });
+
+    it('rejects tiers combined with consumptionPrice', () => {
+        expect(
+            validateDimensionTiers({
+                tiers: validTiers,
+                usageIncrement: '1',
+                consumptionPrice: '1.00',
+            }),
+        ).toEqual('Tiered dimensions cannot also set consumptionPrice');
+    });
+
+    it('rejects tiers combined with usageEntitlement', () => {
+        expect(
+            validateDimensionTiers({
+                tiers: validTiers,
+                usageIncrement: '1',
+                usageEntitlement: 100,
+            }),
+        ).toEqual('Tiered dimensions cannot also set usageEntitlement');
+    });
+
+    it('rejects tiers combined with overageAllowed true', () => {
+        expect(
+            validateDimensionTiers({
+                tiers: validTiers,
+                usageIncrement: '1',
+                overageAllowed: 'true',
+            }),
+        ).toEqual('Tiered dimensions cannot have overageAllowed set to true');
+    });
+
+    it('rejects overlapping or non-increasing bounds', () => {
+        expect(
+            validateDimensionTiers({
+                usageIncrement: '1',
+                tiers: [
+                    { tierPosition: '1', upperBound: '1000', unitPrice: '0.05' },
+                    { tierPosition: '2', upperBound: '1000', unitPrice: '0.02' },
+                ],
+            }),
+        ).toEqual('Tier bounds must increase without overlap');
+    });
+
+    it('rejects inf anywhere except the last tier', () => {
+        expect(
+            validateDimensionTiers({
+                usageIncrement: '1',
+                tiers: [
+                    { tierPosition: '1', upperBound: 'inf', unitPrice: '0.05' },
+                    { tierPosition: '2', upperBound: '2000', unitPrice: '0.02' },
+                ],
+            }),
+        ).toEqual('"inf" upperBound may only appear on the last tier');
+    });
+
+    it('requires unitPrice after the first tier and allows a free first tier', () => {
+        expect(
+            validateDimensionTiers({
+                usageIncrement: '10',
+                tiers: [
+                    { tierPosition: '1', upperBound: '100' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '0.10' },
+                ],
+            }),
+        ).toBeNull();
+        expect(
+            validateDimensionTiers({
+                usageIncrement: '10',
+                tiers: [
+                    { tierPosition: '1', upperBound: '100' },
+                    { tierPosition: '2', upperBound: 'inf' },
+                ],
+            }),
+        ).toEqual('Every tier after the first requires unitPrice');
+    });
+
+    it('requires upperBound to align to usageIncrement', () => {
+        expect(
+            validateDimensionTiers({
+                usageIncrement: '10',
+                tiers: [
+                    { tierPosition: '1', upperBound: '15', unitPrice: '0.05' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02' },
+                ],
+            }),
+        ).toEqual('upperBound 15 must align to usageIncrement 10');
+    });
+});
+
+describe('allocateUsageAcrossTiers', () => {
+    const tiers = [
+        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02', tierName: 'High volume' },
+        { tierPosition: '1', upperBound: '1000', unitPrice: '0.05', tierName: 'Low volume' },
+    ];
+
+    it('sorts by numeric tierPosition and allocates inclusive bounds', () => {
+        const allocations = allocateUsageAcrossTiers({
+            totalUsage: 1500,
+            tiers,
+            usageIncrement: 1,
+        });
+        expect(allocations).toEqual([
+            expect.objectContaining({ rawUsage: 1000, quantity: 1000, tier: expect.objectContaining({ tierPosition: '1' }) }),
+            expect.objectContaining({ rawUsage: 500, quantity: 500, tier: expect.objectContaining({ tierPosition: '2' }) }),
+        ]);
+    });
+
+    it('includes usage exactly at the inclusive upper bound in that tier', () => {
+        const allocations = allocateUsageAcrossTiers({
+            totalUsage: 1000,
+            tiers,
+            usageIncrement: 1,
+        });
+        expect(allocations).toEqual([
+            expect.objectContaining({ rawUsage: 1000, tier: expect.objectContaining({ tierPosition: '1' }) }),
+        ]);
+    });
+
+    it('divides quantities by usageIncrement', () => {
+        const allocations = allocateUsageAcrossTiers({
+            totalUsage: 250,
+            tiers: [
+                { tierPosition: '1', upperBound: '100' },
+                { tierPosition: '2', upperBound: 'inf', unitPrice: '1.00' },
+            ],
+            usageIncrement: 10,
+        });
+        expect(allocations.map(({ quantity, rawUsage }) => ({ quantity, rawUsage }))).toEqual([
+            { quantity: 10, rawUsage: 100 },
+            { quantity: 15, rawUsage: 150 },
+        ]);
+    });
+});
