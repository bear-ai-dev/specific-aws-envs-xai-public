+++ b/src/dimensions/dto/tierValidator.ts
@@ -0,0 +1,226 @@
+import { Injectable } from '@nestjs/common';
+import {
+    ValidationArguments,
+    ValidationOptions,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+    registerDecorator,
+} from 'class-validator';
+import { UsageTierDto } from './usage-tier.dto.js';
+
+export function isNumericString(value: unknown): value is string {
+    if (typeof value !== 'string' || value.trim() === '') {
+        return false;
+    }
+    return !isNaN(value as unknown as number) && !isNaN(parseFloat(value));
+}
+
+export function hasUsageTiers(tiers?: UsageTierDto[] | null): tiers is UsageTierDto[] {
+    return Array.isArray(tiers) && tiers.length > 0;
+}
+
+export function isUnpricedDimension({
+    tiers,
+    consumptionPrice,
+    usageEntitlement,
+}: {
+    tiers?: UsageTierDto[] | null;
+    consumptionPrice?: string | null;
+    usageEntitlement?: number | 'inf' | null;
+}): boolean {
+    return (
+        !hasUsageTiers(tiers) &&
+        (consumptionPrice === undefined || consumptionPrice === null || consumptionPrice === '') &&
+        (usageEntitlement === undefined || usageEntitlement === null)
+    );
+}
+
+export function validateDimensionTiers({
+    tiers,
+    usageIncrement,
+    consumptionPrice,
+    usageEntitlement,
+    overageAllowed,
+}: {
+    tiers?: UsageTierDto[] | null;
+    usageIncrement?: string | number;
+    consumptionPrice?: string | null;
+    usageEntitlement?: number | 'inf' | null;
+    overageAllowed?: string | null;
+}): string | null {
+    if (!hasUsageTiers(tiers)) {
+        return null;
+    }
+
+    if (consumptionPrice !== undefined && consumptionPrice !== null && consumptionPrice !== '') {
+        return 'Tiered dimensions cannot also set consumptionPrice';
+    }
+    if (usageEntitlement !== undefined && usageEntitlement !== null) {
+        return 'Tiered dimensions cannot also set usageEntitlement';
+    }
+    if (overageAllowed === 'true') {
+        return 'Tiered dimensions cannot have overageAllowed set to true';
+    }
+
+    const increment = usageIncrement === undefined || usageIncrement === null || usageIncrement === ''
+        ? undefined
+        : Number(usageIncrement);
+    if (increment !== undefined && (!Number.isFinite(increment) || increment <= 0 || !Number.isInteger(increment))) {
+        return 'usageIncrement must be a positive integer when tiers are set';
+    }
+
+    const seenPositions = new Set<number>();
+    for (const tier of tiers) {
+        if (!isNumericString(tier?.tierPosition)) {
+            return 'tierPosition must be a numeric string';
+        }
+        const position = Number(tier.tierPosition);
+        if (seenPositions.has(position)) {
+            return 'tierPosition values must be unique';
+        }
+        seenPositions.add(position);
+
+        if (tier.upperBound !== 'inf' && !isNumericString(tier.upperBound)) {
+            return 'upperBound must be a numeric string or "inf"';
+        }
+        if (tier.upperBound !== 'inf') {
+            const bound = Number(tier.upperBound);
+            if (bound < 0) {
+                return 'upperBound must be greater than or equal to 0';
+            }
+            if (increment !== undefined && bound % increment !== 0) {
+                return `upperBound ${tier.upperBound} must align to usageIncrement ${usageIncrement}`;
+            }
+        }
+
+        if (tier.unitPrice !== undefined && tier.unitPrice !== null && tier.unitPrice !== '') {
+            if (!isNumericString(tier.unitPrice)) {
+                return 'unitPrice must be a numeric string';
+            }
+        }
+    }
+
+    const sorted = [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+    for (let index = 0; index < sorted.length; index++) {
+        const tier = sorted[index];
+        if (index > 0 && (tier.unitPrice === undefined || tier.unitPrice === null || tier.unitPrice === '')) {
+            return 'Every tier after the first requires unitPrice';
+        }
+        if (tier.upperBound === 'inf' && index !== sorted.length - 1) {
+            return '"inf" upperBound may only appear on the last tier';
+        }
+        if (index > 0) {
+            const previous = sorted[index - 1];
+            const previousBound = previous.upperBound === 'inf' ? Number.POSITIVE_INFINITY : Number(previous.upperBound);
+            const currentBound = tier.upperBound === 'inf' ? Number.POSITIVE_INFINITY : Number(tier.upperBound);
+            if (!(currentBound > previousBound)) {
+                return 'Tier bounds must increase without overlap';
+            }
+        }
+    }
+
+    return null;
+}
+
+@ValidatorConstraint({ name: 'ValidateUsageTiers', async: false })
+@Injectable()
+export class ValidateUsageTiersRule implements ValidatorConstraintInterface {
+    validate(tiers: UsageTierDto[] | null | undefined, args: ValidationArguments) {
+        const dimension = args.object as {
+            usageIncrement?: string | number;
+            consumptionPrice?: string | null;
+            usageEntitlement?: number | 'inf' | null;
+            overageAllowed?: string | null;
+        };
+        return (
+            validateDimensionTiers({
+                tiers,
+                usageIncrement: dimension?.usageIncrement,
+                consumptionPrice: dimension?.consumptionPrice,
+                usageEntitlement: dimension?.usageEntitlement,
+                overageAllowed: dimension?.overageAllowed,
+            }) === null
+        );
+    }
+
+    defaultMessage(args: ValidationArguments) {
+        const dimension = args.object as {
+            tiers?: UsageTierDto[] | null;
+            usageIncrement?: string | number;
+            consumptionPrice?: string | null;
+            usageEntitlement?: number | 'inf' | null;
+            overageAllowed?: string | null;
+        };
+        return (
+            validateDimensionTiers({
+                tiers: dimension?.tiers,
+                usageIncrement: dimension?.usageIncrement,
+                consumptionPrice: dimension?.consumptionPrice,
+                usageEntitlement: dimension?.usageEntitlement,
+                overageAllowed: dimension?.overageAllowed,
+            }) || 'Invalid usage tiers'
+        );
+    }
+}
+
+export function ValidateUsageTiers(validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'ValidateUsageTiers',
+            target: (object as { constructor: new (...args: unknown[]) => unknown }).constructor,
+            propertyName: propertyName,
+            options: validationOptions,
+            validator: ValidateUsageTiersRule,
+        });
+    };
+}
+
+export type AllocatedUsageTier = {
+    tier: UsageTierDto;
+    rawUsage: number;
+    quantity: number;
+};
+
+export function allocateUsageAcrossTiers({
+    totalUsage,
+    tiers,
+    usageIncrement,
+}: {
+    totalUsage: number;
+    tiers: UsageTierDto[];
+    usageIncrement: number;
+}): AllocatedUsageTier[] {
+    const increment = Number(usageIncrement) || 1;
+    const sorted = [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+    const allocations: AllocatedUsageTier[] = [];
+    let remaining = Number(totalUsage);
+    let previousBound = 0;
+
+    if (!Number.isFinite(remaining) || remaining <= 0) {
+        return allocations;
+    }
+
+    for (const tier of sorted) {
+        const currentBound = tier.upperBound === 'inf' ? Number.POSITIVE_INFINITY : Number(tier.upperBound);
+        const capacity = currentBound - previousBound;
+        if (!(capacity > 0)) {
+            previousBound = currentBound;
+            continue;
+        }
+        const consumed = Math.min(remaining, capacity);
+        if (consumed > 0) {
+            allocations.push({
+                tier,
+                rawUsage: consumed,
+                quantity: consumed / increment,
+            });
+            remaining -= consumed;
+        }
+        previousBound = currentBound;
+        if (remaining <= 0) {
+            break;
+        }
+    }
+
+    return allocations;
+}
