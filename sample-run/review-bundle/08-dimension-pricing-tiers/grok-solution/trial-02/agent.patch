diff --git a/src/dimensions/dto/tierValidator.spec.ts b/src/dimensions/dto/tierValidator.spec.ts
new file mode 100644
index 0000000..39dc93c
--- /dev/null
+++ b/src/dimensions/dto/tierValidator.spec.ts
@@ -0,0 +1,87 @@
+import { getDimensionTiersValidationError, hasDimensionTiers, sortTiersByPosition } from './tierValidator.js';
+
+describe('tierValidator', () => {
+    const validTiers = [
+        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.05' },
+        { tierPosition: '1', upperBound: '1000', unitPrice: '0.10' },
+    ];
+
+    it('accepts omitted first-tier prices as a free allowance', () => {
+        expect(
+            getDimensionTiersValidationError(
+                [
+                    { tierPosition: '1', upperBound: '100', tierName: 'Free' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '0.25' },
+                ],
+                { usageIncrement: '1' },
+            ),
+        ).toBeNull();
+    });
+
+    it('rejects overlapping or decreasing bounds', () => {
+        expect(
+            getDimensionTiersValidationError(
+                [
+                    { tierPosition: '1', upperBound: '200', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: '100', unitPrice: '2' },
+                ],
+                { usageIncrement: '1' },
+            ),
+        ).toEqual('tier upperBound values must increase without overlap');
+    });
+
+    it('rejects inf anywhere except the last tier', () => {
+        expect(
+            getDimensionTiersValidationError(
+                [
+                    { tierPosition: '1', upperBound: 'inf', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: '200', unitPrice: '2' },
+                ],
+                { usageIncrement: '1' },
+            ),
+        ).toEqual('"inf" is only allowed as the last tier upperBound');
+    });
+
+    it('requires later tiers to include unitPrice', () => {
+        expect(
+            getDimensionTiersValidationError(
+                [
+                    { tierPosition: '1', upperBound: '100' },
+                    { tierPosition: '2', upperBound: 'inf' },
+                ],
+                { usageIncrement: '1' },
+            ),
+        ).toEqual('every tier after the first requires unitPrice');
+    });
+
+    it('requires bounds to align to usageIncrement', () => {
+        expect(
+            getDimensionTiersValidationError(
+                [
+                    { tierPosition: '1', upperBound: '15', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '2' },
+                ],
+                { usageIncrement: '10' },
+            ),
+        ).toEqual('tier upperBound values must align to usageIncrement');
+    });
+
+    it('is mutually exclusive with consumptionPrice, usageEntitlement, and overageAllowed true', () => {
+        expect(getDimensionTiersValidationError(validTiers, { consumptionPrice: '1.00' })).toEqual(
+            'tiers cannot be combined with consumptionPrice',
+        );
+        expect(getDimensionTiersValidationError(validTiers, { usageEntitlement: 10 })).toEqual(
+            'tiers cannot be combined with usageEntitlement',
+        );
+        expect(getDimensionTiersValidationError(validTiers, { overageAllowed: 'true' })).toEqual(
+            'tiers cannot be combined with overageAllowed: true',
+        );
+    });
+
+    it('sorts tiers by numeric position and treats empty arrays as absent', () => {
+        expect(sortTiersByPosition(validTiers).map((tier) => tier.tierPosition)).toEqual(['1', '2']);
+        expect(hasDimensionTiers(undefined)).toBe(false);
+        expect(hasDimensionTiers([])).toBe(false);
+        expect(hasDimensionTiers(validTiers)).toBe(true);
+    });
+});
diff --git a/src/dimensions/dto/tierValidator.ts b/src/dimensions/dto/tierValidator.ts
new file mode 100644
index 0000000..e3e8b84
--- /dev/null
+++ b/src/dimensions/dto/tierValidator.ts
@@ -0,0 +1,164 @@
+import { Injectable } from '@nestjs/common';
+import {
+    ValidationArguments,
+    ValidationOptions,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+    registerDecorator,
+} from 'class-validator';
+
+export type DimensionTierInput = {
+    tierPosition?: string;
+    upperBound?: string;
+    tierName?: string;
+    unitPrice?: string;
+};
+
+export type DimensionTiersValidationContext = {
+    usageIncrement?: string | number;
+    consumptionPrice?: string | null;
+    usageEntitlement?: number | 'inf' | null;
+    overageAllowed?: string | null;
+};
+
+const isNumericString = (value: unknown): value is string => {
+    if (typeof value !== 'string' || value.trim() === '') {
+        return false;
+    }
+    return !isNaN(value as unknown as number) && !isNaN(parseFloat(value));
+};
+
+const parseBound = (upperBound: string): number => {
+    if (upperBound === 'inf') {
+        return Number.POSITIVE_INFINITY;
+    }
+    return parseFloat(upperBound);
+};
+
+export const hasDimensionTiers = (tiers: unknown): tiers is DimensionTierInput[] =>
+    Array.isArray(tiers) && tiers.length > 0;
+
+export const sortTiersByPosition = <T extends DimensionTierInput>(tiers: T[]): T[] =>
+    [...tiers].sort((left, right) => Number(left.tierPosition) - Number(right.tierPosition));
+
+export const getDimensionTiersValidationError = (
+    tiers: unknown,
+    context: DimensionTiersValidationContext = {},
+): string | null => {
+    if (tiers === undefined || tiers === null) {
+        return null;
+    }
+    if (!Array.isArray(tiers) || tiers.length === 0) {
+        return 'tiers must be a non-empty array of volume pricing tiers';
+    }
+
+    if (context.usageEntitlement !== undefined && context.usageEntitlement !== null) {
+        return 'tiers cannot be combined with usageEntitlement';
+    }
+    if (context.consumptionPrice !== undefined && context.consumptionPrice !== null && context.consumptionPrice !== '') {
+        return 'tiers cannot be combined with consumptionPrice';
+    }
+    if (context.overageAllowed === 'true') {
+        return 'tiers cannot be combined with overageAllowed: true';
+    }
+
+    const seenPositions = new Set<string>();
+    let previousBound = 0;
+    const increment =
+        context.usageIncrement !== undefined && context.usageIncrement !== null && context.usageIncrement !== ''
+            ? Number(context.usageIncrement)
+            : undefined;
+
+    const sortedTiers = sortTiersByPosition(tiers as DimensionTierInput[]);
+    if (sortedTiers.some((tier) => !isNumericString(tier?.tierPosition))) {
+        return 'tierPosition must be a numeric string';
+    }
+
+    for (let index = 0; index < sortedTiers.length; index += 1) {
+        const tier = sortedTiers[index];
+        if (!tier || typeof tier !== 'object') {
+            return 'each tier must be an object';
+        }
+        if (!isNumericString(tier.tierPosition)) {
+            return 'tierPosition must be a numeric string';
+        }
+        if (seenPositions.has(tier.tierPosition)) {
+            return 'tierPosition values must be unique';
+        }
+        seenPositions.add(tier.tierPosition);
+
+        if (tier.upperBound === undefined || tier.upperBound === null || typeof tier.upperBound !== 'string') {
+            return 'upperBound must be a numeric string or "inf"';
+        }
+        const isInf = tier.upperBound === 'inf';
+        if (!isInf && !isNumericString(tier.upperBound)) {
+            return 'upperBound must be a numeric string or "inf"';
+        }
+        if (isInf && index !== sortedTiers.length - 1) {
+            return '"inf" is only allowed as the last tier upperBound';
+        }
+        const bound = parseBound(tier.upperBound);
+        if (!isInf && (bound <= previousBound || bound < 0)) {
+            return 'tier upperBound values must increase without overlap';
+        }
+        if (!isInf && increment && increment > 0 && bound % increment !== 0) {
+            return 'tier upperBound values must align to usageIncrement';
+        }
+
+        if (index === 0) {
+            if (tier.unitPrice !== undefined && tier.unitPrice !== null && !isNumericString(tier.unitPrice)) {
+                return 'unitPrice must be a numeric string';
+            }
+        } else if (!isNumericString(tier.unitPrice)) {
+            return 'every tier after the first requires unitPrice';
+        }
+        if (tier.tierName !== undefined && tier.tierName !== null && typeof tier.tierName !== 'string') {
+            return 'tierName must be a string';
+        }
+        previousBound = bound;
+    }
+
+    return null;
+};
+
+@ValidatorConstraint({ name: 'ValidateDimensionTiers', async: false })
+@Injectable()
+export class ValidateDimensionTiersRule implements ValidatorConstraintInterface {
+    validate(tiers: DimensionTierInput[] | null | undefined, args: ValidationArguments) {
+        const dto = args.object as DimensionTiersValidationContext & { tiers?: unknown };
+        return (
+            getDimensionTiersValidationError(tiers, {
+                usageIncrement: dto.usageIncrement,
+                consumptionPrice: dto.consumptionPrice,
+                usageEntitlement: dto.usageEntitlement,
+                overageAllowed: dto.overageAllowed,
+            }) === null
+        );
+    }
+
+    defaultMessage(args: ValidationArguments) {
+        const dto = args.object as DimensionTiersValidationContext & { tiers?: unknown };
+        return (
+            getDimensionTiersValidationError(dto?.tiers, {
+                usageIncrement: dto?.usageIncrement,
+                consumptionPrice: dto?.consumptionPrice,
+                usageEntitlement: dto?.usageEntitlement,
+                overageAllowed: dto?.overageAllowed,
+            }) ||
+            `tiers must be a non-overlapping, increment-aligned sequence of volume prices. The last bound may be "inf". Tiers cannot be combined with usageEntitlement, consumptionPrice, or overageAllowed: true.`
+        );
+    }
+}
+
+export function ValidateDimensionTiers(property: string, validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'ValidateDimensionTiers',
+            target: (object as { constructor: new (...args: unknown[]) => unknown }).constructor,
+            propertyName: propertyName,
+            constraints: [property],
+            options: validationOptions,
+            validator: ValidateDimensionTiersRule,
+        });
+    };
+}
