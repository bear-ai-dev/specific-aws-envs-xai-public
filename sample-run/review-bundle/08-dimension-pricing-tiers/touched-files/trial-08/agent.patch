+import { validate } from 'class-validator';
+import { plainToInstance } from 'class-transformer';
+import {
+    aggregationInterval,
+    aggregationMethod,
+    countBasedUnits,
+    CreateDimensionDto,
+    overageAllowedEnum,
+    roundingEnum,
+} from './create-dimension.dto.js';
+import { getDimensionTiersValidationError, sortTiersByPosition } from './tierValidator.js';
+import { Billing } from '../../billing/entities/billing.entity.js';
+
+const baseDimension = {
+    dimensionName: 'API Call',
+    consumptionUnit: { type: 'count', unit: countBasedUnits['count-based'] },
+    usageIncrement: '1',
+    rounding: roundingEnum.ceiling,
+    aggregationInterval: aggregationInterval.hour,
+    aggregationMethod: aggregationMethod.sum,
+};
+
+describe('Dimension volume tiers', () => {
+    it('accepts a free first tier and priced later tiers', () => {
+        const error = getDimensionTiersValidationError({
+            ...baseDimension,
+            tiers: [
+                { tierPosition: '1', upperBound: '1000', tierName: 'Free' },
+                { tierPosition: '2', upperBound: 'inf', unitPrice: '0.10', tierName: 'Paid' },
+            ],
+        });
+        expect(error).toBeUndefined();
+    });
+
+    it('rejects overlapping or non-increasing bounds', () => {
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                tiers: [
+                    { tierPosition: '1', upperBound: '1000', unitPrice: '0.10' },
+                    { tierPosition: '2', upperBound: '1000', unitPrice: '0.05' },
+                ],
+            }),
+        ).toMatch(/increase without overlap/i);
+    });
+
+    it('rejects inf anywhere except the last tier', () => {
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                tiers: [
+                    { tierPosition: '1', upperBound: 'inf', unitPrice: '0.10' },
+                    { tierPosition: '2', upperBound: '2000', unitPrice: '0.05' },
+                ],
+            }),
+        ).toMatch(/last tier/i);
+    });
+
+    it('requires unitPrice after the first tier', () => {
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                tiers: [
+                    { tierPosition: '1', upperBound: '1000' },
+                    { tierPosition: '2', upperBound: 'inf' },
+                ],
+            }),
+        ).toMatch(/requires unitPrice/i);
+    });
+
+    it('rejects tiers combined with consumptionPrice, entitlement, or overage', () => {
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                consumptionPrice: '1.00',
+                tiers: [{ tierPosition: '1', upperBound: 'inf', unitPrice: '0.10' }],
+            }),
+        ).toMatch(/consumptionPrice/);
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                usageEntitlement: 10,
+                tiers: [{ tierPosition: '1', upperBound: 'inf', unitPrice: '0.10' }],
+            }),
+        ).toMatch(/usageEntitlement/);
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                overageAllowed: overageAllowedEnum.true,
+                tiers: [{ tierPosition: '1', upperBound: 'inf', unitPrice: '0.10' }],
+            }),
+        ).toMatch(/overageAllowed/);
+    });
+
+    it('requires upperBound to align to usageIncrement', () => {
+        expect(
+            getDimensionTiersValidationError({
+                ...baseDimension,
+                usageIncrement: '10',
+                tiers: [
+                    { tierPosition: '1', upperBound: '15', unitPrice: '0.10' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '0.05' },
+                ],
+            }),
+        ).toMatch(/usageIncrement/);
+    });
+
+    it('sorts tiers by numeric position regardless of input order', () => {
+        const sorted = sortTiersByPosition([
+            { tierPosition: '10', upperBound: 'inf', unitPrice: '0.01' },
+            { tierPosition: '2', upperBound: '20', unitPrice: '0.05' },
+        ]);
+        expect(sorted.map((tier) => tier.tierPosition)).toEqual(['2', '10']);
+    });
+
+    it('allocates inclusive usage across consumed tiers only', () => {
+        const allocations = Billing.allocateUsageToTiers(1500, [
+            { tierPosition: '2', upperBound: 'inf', unitPrice: '0.05', tierName: 'Overage' },
+            { tierPosition: '1', upperBound: '1000', tierName: 'Included' },
+        ]);
+        expect(allocations).toEqual([
+            expect.objectContaining({ quantity: 1000, tier: expect.objectContaining({ tierName: 'Included' }) }),
+            expect.objectContaining({ quantity: 500, tier: expect.objectContaining({ tierName: 'Overage' }) }),
+        ]);
+    });
+
+    it('keeps usage that exactly matches an inclusive bound in that tier', () => {
+        const allocations = Billing.allocateUsageToTiers(1000, [
+            { tierPosition: '1', upperBound: '1000', unitPrice: '0.10' },
+            { tierPosition: '2', upperBound: 'inf', unitPrice: '0.05' },
+        ]);
+        expect(allocations).toHaveLength(1);
+        expect(allocations[0].quantity).toBe(1000);
+        expect(allocations[0].tier.tierPosition).toBe('1');
+    });
+
+    it('validates a create DTO with class-validator', async () => {
+        const dto = plainToInstance(CreateDimensionDto, {
+            ...baseDimension,
+            tiers: [
+                { tierPosition: '1', upperBound: '1000', tierName: 'Free' },
+                { tierPosition: '2', upperBound: 'inf', unitPrice: '0.10' },
+            ],
+        });
+        const errors = await validate(dto);
+        expect(errors).toHaveLength(0);
+    });
+
+    it('fails class-validator when a later tier is missing unitPrice', async () => {
+        const dto = plainToInstance(CreateDimensionDto, {
+            ...baseDimension,
+            tiers: [
+                { tierPosition: '1', upperBound: '1000' },
+                { tierPosition: '2', upperBound: 'inf' },
+            ],
+        });
+        const errors = await validate(dto);
+        expect(errors.some((error) => error.property === 'tiers')).toBe(true);
+    });
+});
