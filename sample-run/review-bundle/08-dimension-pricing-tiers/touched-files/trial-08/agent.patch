@@ -0,0 +1,146 @@
+import { Injectable } from '@nestjs/common';
+import {
+    ValidationArguments,
+    ValidationOptions,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+    registerDecorator,
+} from 'class-validator';
+export type DimensionTierLike = {
+    tierPosition?: string;
+    upperBound?: string;
+    tierName?: string;
+    unitPrice?: string;
+};
+
+export function isNumericString(value: unknown): boolean {
+    if (typeof value !== 'string' || value.trim() === '') {
+        return false;
+    }
+    return !isNaN(value as unknown as number) && !isNaN(parseFloat(value));
+}
+
+export function parseBound(upperBound: string): number {
+    if (upperBound === 'inf') {
+        return Infinity;
+    }
+    return parseFloat(upperBound);
+}
+
+export function sortTiersByPosition<T extends DimensionTierLike>(tiers: T[]): T[] {
+    return [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+}
+
+export function getDimensionTiersValidationError(
+    dto: {
+        tiers?: DimensionTierLike[] | null;
+        consumptionPrice?: string | null;
+        usageEntitlement?: number | 'inf' | null;
+        overageAllowed?: string | null;
+        usageIncrement?: string | number;
+    },
+): string | undefined {
+    const tiers = dto?.tiers;
+    if (tiers === undefined || tiers === null || (Array.isArray(tiers) && tiers.length === 0)) {
+        return undefined;
+    }
+    if (!Array.isArray(tiers)) {
+        return 'tiers must be an array of tier objects';
+    }
+
+    if (dto.consumptionPrice !== undefined && dto.consumptionPrice !== null && dto.consumptionPrice !== '') {
+        return 'Tiered dimensions cannot be combined with consumptionPrice';
+    }
+    if (dto.usageEntitlement !== undefined && dto.usageEntitlement !== null) {
+        return 'Tiered dimensions cannot be combined with usageEntitlement';
+    }
+    if (dto.overageAllowed === 'true') {
+        return 'Tiered dimensions cannot be combined with overageAllowed: true';
+    }
+
+    const positions = new Set<string>();
+    for (const [index, tier] of tiers.entries()) {
+        if (!tier || typeof tier !== 'object') {
+            return `tiers[${index}] must be an object`;
+        }
+        if (!isNumericString(tier.tierPosition)) {
+            return `tiers[${index}].tierPosition must be a numeric string`;
+        }
+        if (positions.has(tier.tierPosition as string)) {
+            return `tiers must have unique tierPosition values`;
+        }
+        positions.add(tier.tierPosition as string);
+
+        if (typeof tier.upperBound !== 'string' || tier.upperBound === '') {
+            return `tiers[${index}].upperBound must be a numeric string or "inf"`;
+        }
+        if (tier.upperBound !== 'inf' && !isNumericString(tier.upperBound)) {
+            return `tiers[${index}].upperBound must be a numeric string or "inf"`;
+        }
+        if (tier.unitPrice !== undefined && tier.unitPrice !== null && tier.unitPrice !== '') {
+            if (!isNumericString(tier.unitPrice)) {
+                return `tiers[${index}].unitPrice must be a numeric string`;
+            }
+        }
+    }
+
+    const sorted = sortTiersByPosition(tiers);
+    const usageIncrement = dto.usageIncrement !== undefined ? Number(dto.usageIncrement) : undefined;
+    let previousBound = Number.NEGATIVE_INFINITY;
+
+    for (let i = 0; i < sorted.length; i++) {
+        const tier = sorted[i];
+        const isLast = i === sorted.length - 1;
+        if (tier.upperBound === 'inf' && !isLast) {
+            return 'Only the last tier may use upperBound "inf"';
+        }
+        if (i > 0 && (tier.unitPrice === undefined || tier.unitPrice === null || tier.unitPrice === '')) {
+            return 'Every tier after the first requires unitPrice';
+        }
+
+        const bound = parseBound(tier.upperBound as string);
+        if (tier.upperBound !== 'inf') {
+            if (!Number.isFinite(bound) || bound < 0) {
+                return `tiers upperBound values must be non-negative numeric strings or "inf"`;
+            }
+            if (usageIncrement !== undefined && Number.isFinite(usageIncrement) && usageIncrement !== 0) {
+                if (bound % usageIncrement !== 0) {
+                    return `tiers upperBound values must align to usageIncrement`;
+                }
+            }
+        }
+        if (bound <= previousBound) {
+            return 'tiers upperBound values must increase without overlap';
+        }
+        previousBound = bound;
+    }
+
+    return undefined;
+}
+
+@ValidatorConstraint({ name: 'ValidateDimensionTiers', async: false })
+@Injectable()
+export class ValidateDimensionTiersRule implements ValidatorConstraintInterface {
+    validate(_tiers: DimensionTierLike[] | null | undefined, args: ValidationArguments) {
+        return getDimensionTiersValidationError(args.object as Parameters<typeof getDimensionTiersValidationError>[0]) === undefined;
+    }
+
+    defaultMessage(args: ValidationArguments) {
+        return (
+            getDimensionTiersValidationError(args.object as Parameters<typeof getDimensionTiersValidationError>[0]) ||
+            'Invalid tiers configuration'
+        );
+    }
+}
+
+export function ValidateDimensionTiers(validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'ValidateDimensionTiers',
+            target: (object as { constructor: new (...args: unknown[]) => unknown }).constructor,
+            propertyName: propertyName,
+            options: validationOptions,
+            validator: ValidateDimensionTiersRule,
+        });
+    };
+}
