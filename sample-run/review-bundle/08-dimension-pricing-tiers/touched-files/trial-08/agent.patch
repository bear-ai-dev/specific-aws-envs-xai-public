+    public static allocateUsageToTiers(
+        totalUsage: number,
+        tiers: DimensionTier[],
+    ): Array<{ tier: DimensionTier; quantity: number }> {
+        const sorted = sortTiersByPosition(tiers);
+        const allocations: Array<{ tier: DimensionTier; quantity: number }> = [];
+        let previousBound = 0;
+        let remaining = totalUsage;
+
+        for (const tier of sorted) {
+            const upperBound = parseBound(tier.upperBound);
+            const capacity = Number.isFinite(upperBound) ? Math.max(upperBound - previousBound, 0) : remaining;
+            const quantity = Math.max(0, Math.min(remaining, capacity));
+            if (quantity > 0) {
+                allocations.push({ tier, quantity });
+            }
+            remaining -= quantity;
+            previousBound = Number.isFinite(upperBound) ? upperBound : previousBound;
+            if (remaining <= 0) {
+                break;
+            }
+        }
+
+        return allocations;
+    }
