@@ -0,0 +1,91 @@
+import { validateDimensionTiers } from './tierValidator.js';
+import { DimensionTierDto } from './dimension-tier.dto.js';
+
+const validTiers: DimensionTierDto[] = [
+    { tierPosition: '1', upperBound: '1000', tierName: 'Free', unitPrice: undefined },
+    { tierPosition: '2', upperBound: '5000', tierName: 'Standard', unitPrice: '0.05' },
+    { tierPosition: '3', upperBound: 'inf', unitPrice: '0.02' },
+];
+
+describe('validateDimensionTiers', () => {
+    it('allows omitted tiers', () => {
+        expect(validateDimensionTiers({ usageIncrement: '1' })).toBeNull();
+        expect(validateDimensionTiers({ tiers: null, usageIncrement: '1' })).toBeNull();
+    });
+
+    it('accepts a valid volume-based ladder including a free first tier', () => {
+        expect(validateDimensionTiers({ tiers: validTiers, usageIncrement: '1' })).toBeNull();
+    });
+
+    it('rejects empty arrays', () => {
+        expect(validateDimensionTiers({ tiers: [], usageIncrement: '1' })).toEqual(
+            'tiers must contain at least one pricing tier',
+        );
+    });
+
+    it('is mutually exclusive with usageEntitlement, consumptionPrice, and overageAllowed true', () => {
+        expect(
+            validateDimensionTiers({
+                tiers: validTiers,
+                usageIncrement: '1',
+                usageEntitlement: 100,
+            }),
+        ).toMatch(/usageEntitlement/);
+        expect(
+            validateDimensionTiers({
+                tiers: validTiers,
+                usageIncrement: '1',
+                consumptionPrice: '1.00',
+            }),
+        ).toMatch(/consumptionPrice/);
+        expect(
+            validateDimensionTiers({
+                tiers: validTiers,
+                usageIncrement: '1',
+                overageAllowed: 'true',
+            }),
+        ).toMatch(/overageAllowed/);
+    });
+
+    it('requires unitPrice on every tier after the first by numeric position', () => {
+        expect(
+            validateDimensionTiers({
+                tiers: [
+                    { tierPosition: '2', upperBound: 'inf' },
+                    { tierPosition: '1', upperBound: '10', unitPrice: '1' },
+                ],
+                usageIncrement: '1',
+            }),
+        ).toMatch(/unitPrice/);
+    });
+
+    it('requires increasing non-overlapping bounds aligned to usageIncrement', () => {
+        expect(
+            validateDimensionTiers({
+                tiers: [
+                    { tierPosition: '1', upperBound: '15', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '2' },
+                ],
+                usageIncrement: '10',
+            }),
+        ).toMatch(/usageIncrement/);
+        expect(
+            validateDimensionTiers({
+                tiers: [
+                    { tierPosition: '1', upperBound: '20', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: '10', unitPrice: '2' },
+                ],
+                usageIncrement: '10',
+            }),
+        ).toMatch(/increase/);
+        expect(
+            validateDimensionTiers({
+                tiers: [
+                    { tierPosition: '1', upperBound: 'inf', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: '10', unitPrice: '2' },
+                ],
+                usageIncrement: '10',
+            }),
+        ).toMatch(/inf/);
+    });
+});
diff --git a/src/dimensions/dto/tierValidator.ts b/src/dimensions/dto/tierValidator.ts
new file mode 100644
index 0000000..d777db6
--- /dev/null
+++ b/src/dimensions/dto/tierValidator.ts
@@ -0,0 +1,159 @@
+import { Injectable } from '@nestjs/common';
+import {
+    ValidationArguments,
+    ValidationOptions,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+    registerDecorator,
+} from 'class-validator';
+import { DimensionTierDto } from './dimension-tier.dto.js';
+
+const isNumericString = (value: unknown): boolean => {
+    if (typeof value !== 'string' || value.trim() === '') {
+        return false;
+    }
+    return !isNaN(value as unknown as number) && !isNaN(parseFloat(value));
+};
+
+export const hasTiers = (tiers?: DimensionTierDto[] | null): tiers is DimensionTierDto[] => {
+    return Array.isArray(tiers) && tiers.length > 0;
+};
+
+export const validateDimensionTiers = ({
+    tiers,
+    usageIncrement,
+    usageEntitlement,
+    consumptionPrice,
+    overageAllowed,
+}: {
+    tiers?: DimensionTierDto[] | null;
+    usageIncrement?: string | number;
+    usageEntitlement?: number | 'inf' | null;
+    consumptionPrice?: string | null;
+    overageAllowed?: string | null;
+}): string | null => {
+    if (tiers === undefined || tiers === null) {
+        return null;
+    }
+    if (!Array.isArray(tiers)) {
+        return 'tiers must be an array of pricing tiers';
+    }
+    if (tiers.length === 0) {
+        return 'tiers must contain at least one pricing tier';
+    }
+    if (usageEntitlement !== undefined && usageEntitlement !== null) {
+        return 'tiers cannot be combined with usageEntitlement';
+    }
+    if (consumptionPrice !== undefined && consumptionPrice !== null && consumptionPrice !== '') {
+        return 'tiers cannot be combined with consumptionPrice';
+    }
+    if (overageAllowed === 'true') {
+        return 'tiers cannot be combined with overageAllowed: true';
+    }
+
+    const increment = Number(usageIncrement);
+    const hasIncrement = usageIncrement !== undefined && usageIncrement !== null && usageIncrement !== '';
+    if (hasIncrement && (!Number.isFinite(increment) || increment <= 0)) {
+        return 'usageIncrement must be a positive integer to validate tiers';
+    }
+
+    const seenPositions = new Set<number>();
+    for (let i = 0; i < tiers.length; i++) {
+        const tier = tiers[i];
+        if (!tier || typeof tier !== 'object') {
+            return `tiers[${i}] must be an object`;
+        }
+        if (!isNumericString(tier.tierPosition)) {
+            return `tiers[${i}].tierPosition must be a numeric string`;
+        }
+        const position = Number(tier.tierPosition);
+        if (!Number.isFinite(position)) {
+            return `tiers[${i}].tierPosition must be a numeric string`;
+        }
+        if (seenPositions.has(position)) {
+            return `tiers[${i}].tierPosition must be unique`;
+        }
+        seenPositions.add(position);
+
+        if (tier.upperBound !== 'inf' && !isNumericString(tier.upperBound)) {
+            return `tiers[${i}].upperBound must be a numeric string or "inf"`;
+        }
+        if (tier.unitPrice !== undefined && tier.unitPrice !== null && tier.unitPrice !== '') {
+            if (!isNumericString(tier.unitPrice)) {
+                return `tiers[${i}].unitPrice must be a numeric string`;
+            }
+        }
+    }
+
+    const sorted = [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+    for (let i = 1; i < sorted.length; i++) {
+        const unitPrice = sorted[i].unitPrice;
+        if (unitPrice === undefined || unitPrice === null || unitPrice === '') {
+            return 'unitPrice is required for every tier after the first';
+        }
+    }
+    let previousBound = 0;
+    for (let i = 0; i < sorted.length; i++) {
+        const tier = sorted[i];
+        const isLast = i === sorted.length - 1;
+        if (tier.upperBound === 'inf') {
+            if (!isLast) {
+                return 'upperBound "inf" is only allowed on the last tier';
+            }
+            continue;
+        }
+        const bound = Number(tier.upperBound);
+        if (!Number.isFinite(bound) || bound <= 0) {
+            return 'tiers upperBound must be a positive number or "inf"';
+        }
+        if (hasIncrement && bound % increment !== 0) {
+            return `tiers upperBound must align to usageIncrement ${increment}`;
+        }
+        if (bound <= previousBound) {
+            return 'tiers upperBound values must increase without overlap';
+        }
+        previousBound = bound;
+    }
+
+    return null;
+};
+
+@ValidatorConstraint({ name: 'ValidDimensionTiers', async: false })
+@Injectable()
+export class ValidDimensionTiersRule implements ValidatorConstraintInterface {
+    private lastError: string | null = null;
+
+    validate(tiers: DimensionTierDto[] | null | undefined, args: ValidationArguments) {
+        const dto = args.object as {
+            usageIncrement?: string | number;
+            usageEntitlement?: number | 'inf' | null;
+            consumptionPrice?: string | null;
+            overageAllowed?: string | null;
+        };
+        const error = validateDimensionTiers({
+            tiers,
+            usageIncrement: dto?.usageIncrement,
+            usageEntitlement: dto?.usageEntitlement,
+            consumptionPrice: dto?.consumptionPrice,
+            overageAllowed: dto?.overageAllowed,
+        });
+        this.lastError = error;
+        return error === null;
+    }
+
+    defaultMessage() {
+        return this.lastError || 'Invalid pricing tiers';
+    }
+}
+
+export function ValidDimensionTiers(validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'ValidDimensionTiers',
+            target: (object as { constructor: new (...args: unknown[]) => unknown }).constructor,
+            propertyName: propertyName,
+            options: validationOptions,
+            validator: ValidDimensionTiersRule,
+        });
+    };
+}
