+import { Offering } from './offeringPackage.entity.js';
+import { InvoiceLineItem } from '../../invoice/entities/invoice.entity.js';
+
+describe('volume-based pricing tiers', () => {
+    it('allocates usage across inclusive bounds sorted by numeric tierPosition', () => {
+        const allocations = Offering.allocateUsageAcrossTiers(6500, [
+            { tierPosition: '3', upperBound: 'inf', unitPrice: '0.02', tierName: 'Enterprise' },
+            { tierPosition: '1', upperBound: '1000', unitPrice: '0' },
+            { tierPosition: '2', upperBound: '5000', unitPrice: '0.05', tierName: 'Standard' },
+        ]);
+
+        expect(allocations).toEqual([
+            { quantity: 1000, unitPrice: '0', tierName: undefined },
+            { quantity: 4000, unitPrice: '0.05', tierName: 'Standard' },
+            { quantity: 1500, unitPrice: '0.02', tierName: 'Enterprise' },
+        ]);
+    });
+
+    it('omits unused higher tiers', () => {
+        expect(
+            Offering.allocateUsageAcrossTiers(750, [
+                { tierPosition: '1', upperBound: '1000', unitPrice: '1' },
+                { tierPosition: '2', upperBound: 'inf', unitPrice: '2' },
+            ]),
+        ).toEqual([{ quantity: 750, unitPrice: '1', tierName: undefined }]);
+    });
+
+    it('treats omitted first-tier prices as free', () => {
+        expect(
+            Offering.allocateUsageAcrossTiers(10, [{ tierPosition: '1', upperBound: 'inf' }]),
+        ).toEqual([{ quantity: 10, unitPrice: '0', tierName: undefined }]);
+    });
+
+    it('preserves price precision during currency conversion', () => {
+        expect(Offering.convertUnitPrice('1.23456789', 0.91)).toEqual(1.12345678);
+        expect(Offering.convertUnitPrice('2', 0.91)).toEqual(1.82);
+        expect(Offering.convertUnitPrice(undefined, 0.91)).toEqual(0);
+    });
+
+    it('appends tierName to the normal line-item name', () => {
+        const { displayName } = InvoiceLineItem.prepareLineItem({
+            total: 100,
+            dimensionType: 'count',
+            dimensionName: 'API Call',
+            dimensionUnit: 'count-based',
+            dimensionId: 'dim-1',
+            offeringName: 'Pro',
+            usageIncrement: 1,
+            tierName: 'Standard',
+        });
+        expect(displayName).toBe('API Call - Pro Standard');
+    });
+});
