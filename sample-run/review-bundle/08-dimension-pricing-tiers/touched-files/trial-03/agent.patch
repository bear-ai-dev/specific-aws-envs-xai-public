+        const parsedPrice = parseFloat(unitPrice === undefined || unitPrice === null ? '0' : unitPrice.toString());
+        const safePrice = Number.isFinite(parsedPrice) ? parsedPrice : 0;
+        return Number(
+            (safePrice * exchangeRate).toFixed(
+                Offering.getDecimalsForNumber(safePrice) === 0 ? 2 : Offering.getDecimalsForNumber(safePrice),
+            ),
+        );
+    }
+    static allocateUsageAcrossTiers(
+        totalUsage: number,
+        tiers: DimensionTierDto[],
+    ): Array<{ quantity: number; unitPrice: string; tierName?: string }> {
+        const sorted = [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+        const allocations: Array<{ quantity: number; unitPrice: string; tierName?: string }> = [];
+        let previousBound = 0;
+        let remaining = Number(totalUsage);
+
+        for (const tier of sorted) {
+            if (remaining <= 0) {
+                break;
+            }
+            const upperBound = tier.upperBound === 'inf' ? Number.POSITIVE_INFINITY : Number(tier.upperBound);
+            const capacity = Number.isFinite(upperBound) ? Math.max(upperBound - previousBound, 0) : remaining;
+            const quantity = Math.min(remaining, capacity);
+            if (quantity > 0) {
+                allocations.push({
+                    quantity,
+                    unitPrice: tier.unitPrice ?? '0',
+                    tierName: tier.tierName,
+                });
+                remaining -= quantity;
+            }
+            if (Number.isFinite(upperBound)) {
+                previousBound = upperBound;
+            }
+        }
+
+        return allocations;
+    }
