+import { ApiProperty } from '@nestjs/swagger';
+import { IsNotEmpty, IsNumberString, IsOptional, IsString } from 'class-validator';
+import { ValidateDecimalPlace } from './validateDecimalPlaces.js';
+
+/**
+ * A volume-based pricing tier for a usage dimension.
+ * Numerical values are represented as strings to avoid precision loss.
+ */
+export class DimensionTierDto {
+    /**
+     * The position of the tier in the pricing ladder.
+     * Billing sorts tiers by the numeric value of this field.
+     *
+     * @example "1"
+     */
+    @IsNumberString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'tierPosition',
+        example: '1',
+        type: String,
+        description: 'The position of the tier in the pricing ladder. Billing sorts by the numeric value.',
+    })
+    public tierPosition: string;
+
+    /**
+     * Inclusive upper bound of usage for this tier.
+     * Must be a numeric string or `"inf"` for an unbounded final tier.
+     *
+     * @example "1000"
+     * @example "inf"
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'upperBound',
+        examples: ['1000', 'inf'],
+        type: String,
+        description: 'Inclusive upper bound of usage for this tier. A numeric string or "inf".',
+    })
+    public upperBound: string;
+
+    /**
+     * Optional friendly name appended to the invoice line-item name when this tier is consumed.
+     *
+     * @example "Standard"
+     */
+    @IsOptional()
+    @IsString()
+    @ApiProperty({
+        name: 'tierName',
+        example: 'Standard',
+        type: String,
+        required: false,
+        description: 'Optional friendly name appended to the invoice line-item name when this tier is consumed.',
+    })
+    public tierName?: string;
+
+    /**
+     * Unit price for usage that falls in this tier.
+     * Numerical values are represented as strings to avoid precision loss.
+     * May be omitted on the first tier to represent a free tier.
+     *
+     * @example "0.05"
+     */
+    @IsOptional()
+    @IsNumberString()
+    @ValidateDecimalPlace('unitPrice')
+    @ApiProperty({
+        name: 'unitPrice',
+        example: '0.05',
+        type: String,
+        required: false,
+        description:
+            'Unit price for usage that falls in this tier. May be omitted on the first tier to represent a free tier.',
+    })
+    public unitPrice?: string;
+}
