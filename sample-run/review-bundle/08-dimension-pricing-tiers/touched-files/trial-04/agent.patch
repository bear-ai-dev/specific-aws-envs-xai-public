+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import {
+    aggregationInterval,
+    aggregationMethod,
+    CreateDimensionDto,
+    roundingEnum,
+} from './create-dimension.dto.js';
+import { allocateUsageAcrossTiers, getDimensionPricingErrors } from './tier.dto.js';
+
+const baseDimension = {
+    dimensionName: 'API Call',
+    consumptionUnit: { type: 'count', unit: 'count-based' },
+    usageIncrement: '1',
+    rounding: roundingEnum.ceiling,
+    aggregationInterval: aggregationInterval.hour,
+    aggregationMethod: aggregationMethod.sum,
+};
+
+describe('dimension pricing tiers', () => {
+    describe('getDimensionPricingErrors', () => {
+        it('accepts omitted tiers for unpriced dimensions', () => {
+            expect(
+                getDimensionPricingErrors({
+                    usageIncrement: '1',
+                }),
+            ).toEqual([]);
+        });
+
+        it('accepts null tiers so they can be cleared', () => {
+            expect(
+                getDimensionPricingErrors({
+                    usageIncrement: '1',
+                    tiers: null,
+                    consumptionPrice: '1.00',
+                }),
+            ).toEqual([]);
+        });
+
+        it('rejects empty arrays', () => {
+            expect(
+                getDimensionPricingErrors({
+                    usageIncrement: '1',
+                    tiers: [],
+                }),
+            ).toContain('tiers must contain at least one tier');
+        });
+
+        it('rejects combinations with entitlement, consumptionPrice, and overageAllowed true', () => {
+            const errors = getDimensionPricingErrors({
+                usageIncrement: '1',
+                consumptionPrice: '1.00',
+                usageEntitlement: 100,
+                overageAllowed: 'true',
+                tiers: [
+                    { tierPosition: '1', upperBound: '100', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '0.5' },
+                ],
+            });
+            expect(errors).toEqual(
+                expect.arrayContaining([
+                    'Tiered dimensions cannot be combined with usageEntitlement',
+                    'Tiered dimensions cannot be combined with consumptionPrice',
+                    'Tiered dimensions cannot be combined with overageAllowed: true',
+                ]),
+            );
+        });
+
+        it('requires unitPrice after the first tier and increasing aligned bounds', () => {
+            const errors = getDimensionPricingErrors({
+                usageIncrement: '10',
+                tiers: [
+                    { tierPosition: '2', upperBound: '15' },
+                    { tierPosition: '1', upperBound: 'inf', unitPrice: '1' },
+                    { tierPosition: '3', upperBound: '20', unitPrice: '0.5' },
+                ],
+            });
+            expect(errors.join(' ')).toContain('Every tier after the first requires unitPrice');
+            expect(errors.join(' ')).toContain('"inf" upperBound is only allowed on the last tier');
+            expect(errors.join(' ')).toContain('must align to usageIncrement');
+        });
+
+        it('accepts a free first tier and an infinite last bound', () => {
+            expect(
+                getDimensionPricingErrors({
+                    usageIncrement: '100',
+                    tiers: [
+                        { tierPosition: '1', upperBound: '1000', tierName: 'Free' },
+                        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02', tierName: 'Paid' },
+                    ],
+                }),
+            ).toEqual([]);
+        });
+    });
+
+    describe('allocateUsageAcrossTiers', () => {
+        const tiers = [
+            { tierPosition: '2', upperBound: '5000', unitPrice: '0.05', tierName: 'Growth' },
+            { tierPosition: '1', upperBound: '1000', tierName: 'Free' },
+            { tierPosition: '3', upperBound: 'inf', unitPrice: '0.01', tierName: 'Enterprise' },
+        ];
+
+        it('sorts by numeric tierPosition and allocates inclusive bounds', () => {
+            expect(allocateUsageAcrossTiers(1000, tiers)).toEqual([
+                { tier: tiers[1], allocatedUsage: 1000 },
+            ]);
+            expect(allocateUsageAcrossTiers(5000, tiers)).toEqual([
+                { tier: tiers[1], allocatedUsage: 1000 },
+                { tier: tiers[0], allocatedUsage: 4000 },
+            ]);
+            expect(allocateUsageAcrossTiers(5001, tiers)).toEqual([
+                { tier: tiers[1], allocatedUsage: 1000 },
+                { tier: tiers[0], allocatedUsage: 4000 },
+                { tier: tiers[2], allocatedUsage: 1 },
+            ]);
+        });
+    });
+
+    describe('CreateDimensionDto validation', () => {
+        it('accepts a valid tiered dimension without consumptionPrice', async () => {
+            const dto = plainToInstance(CreateDimensionDto, {
+                ...baseDimension,
+                tiers: [
+                    { tierPosition: '1', upperBound: '1000' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '0.25' },
+                ],
+            });
+            expect(await validate(dto)).toEqual([]);
+        });
+
+        it('rejects overlapping or exclusive field combinations', async () => {
+            const dto = plainToInstance(CreateDimensionDto, {
+                ...baseDimension,
+                consumptionPrice: '1.00',
+                usageEntitlement: 10,
+                overageAllowed: 'true',
+                tiers: [
+                    { tierPosition: '1', upperBound: '10', unitPrice: '1' },
+                    { tierPosition: '2', upperBound: 'inf', unitPrice: '2' },
+                ],
+            });
+            const errors = await validate(dto);
+            expect(errors.some((error) => error.property === 'tiers')).toBe(true);
+        });
+    });
+});
diff --git a/src/dimensions/dto/tier.dto.ts b/src/dimensions/dto/tier.dto.ts
new file mode 100644
index 0000000..51b3232
--- /dev/null
+++ b/src/dimensions/dto/tier.dto.ts
@@ -0,0 +1,207 @@
+import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';
+import { IsNotEmpty, IsOptional, IsString } from 'class-validator';
+import { ValidateDecimalPlace } from './validateDecimalPlaces.js';
+
+/**
+ * A volume-based pricing tier for a usage dimension.
+ * Usage is allocated across inclusive upper bounds in tierPosition order.
+ */
+export class DimensionTierDto {
+    /**
+     * The ordinal position of this tier. Used to sort tiers numerically
+     * when allocating usage. Represented as a string to avoid precision loss.
+     *
+     * Example: `"1"`
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'tierPosition',
+        type: String,
+        example: '1',
+        description: 'The ordinal position of this tier. Used to sort tiers numerically when allocating usage.',
+    })
+    public tierPosition: string;
+
+    /**
+     * Inclusive upper bound of this tier. Must be a numeric string or `"inf"`.
+     * `"inf"` is only allowed on the last tier.
+     *
+     * Example: `"1000"`
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'upperBound',
+        type: String,
+        example: '1000',
+        description: 'Inclusive upper bound of this tier. Must be a numeric string or "inf".',
+    })
+    public upperBound: string;
+
+    /**
+     * Optional display name appended to the invoice line-item name when this tier is consumed.
+     *
+     * Example: `"Volume Discount"`
+     */
+    @IsOptional()
+    @IsString()
+    @ApiPropertyOptional({
+        name: 'tierName',
+        type: String,
+        example: 'Volume Discount',
+        description: 'Optional display name appended to the invoice line-item name when this tier is consumed.',
+    })
+    public tierName?: string;
+
+    /**
+     * Unit price for usage that falls in this tier. Numerical values are represented as strings
+     * to avoid precision loss. Required on every tier after the first. An omitted first-tier
+     * price represents a free tier.
+     *
+     * Example: `"0.05"`
+     */
+    @IsOptional()
+    @IsString()
+    @ValidateDecimalPlace('unitPrice')
+    @ApiPropertyOptional({
+        name: 'unitPrice',
+        type: String,
+        example: '0.05',
+        description:
+            'Unit price for usage that falls in this tier. Required on every tier after the first. An omitted first-tier price represents a free tier.',
+    })
+    public unitPrice?: string;
+}
+
+export type DimensionPricingFields = {
+    tiers?: DimensionTierDto[] | null;
+    usageIncrement?: string | number;
+    consumptionPrice?: string | null;
+    usageEntitlement?: number | 'inf' | null;
+    overageAllowed?: string | null;
+};
+
+const isPresent = (value: unknown): boolean => value !== undefined && value !== null && value !== '';
+
+export const hasPricingTiers = (tiers?: DimensionTierDto[] | null): tiers is DimensionTierDto[] =>
+    Array.isArray(tiers) && tiers.length > 0;
+
+const isNumericString = (value: unknown): value is string =>
+    typeof value === 'string' && value.trim() !== '' && !Number.isNaN(Number(value)) && Number.isFinite(Number(value));
+
+export const getDimensionPricingErrors = (dto: DimensionPricingFields): string[] => {
+    const errors: string[] = [];
+    const { tiers, usageIncrement, consumptionPrice, usageEntitlement, overageAllowed } = dto;
+
+    if (tiers === undefined || tiers === null) {
+        return errors;
+    }
+
+    if (!Array.isArray(tiers)) {
+        errors.push('tiers must be an array of tier objects or null');
+        return errors;
+    }
+
+    if (tiers.length === 0) {
+        errors.push('tiers must contain at least one tier');
+        return errors;
+    }
+
+    if (isPresent(usageEntitlement)) {
+        errors.push('Tiered dimensions cannot be combined with usageEntitlement');
+    }
+    if (isPresent(consumptionPrice)) {
+        errors.push('Tiered dimensions cannot be combined with consumptionPrice');
+    }
+    if (overageAllowed === 'true') {
+        errors.push('Tiered dimensions cannot be combined with overageAllowed: true');
+    }
+
+    const increment = Number(usageIncrement);
+    const canValidateIncrement = Number.isFinite(increment) && increment > 0;
+
+    const seenPositions = new Set<string>();
+    const sorted = [...tiers].sort((a, b) => Number(a?.tierPosition) - Number(b?.tierPosition));
+
+    for (let index = 0; index < sorted.length; index++) {
+        const tier = sorted[index];
+        if (!tier || typeof tier !== 'object') {
+            errors.push('Each tier must be an object');
+            continue;
+        }
+
+        if (!isNumericString(tier.tierPosition)) {
+            errors.push('tierPosition must be a numeric string');
+        } else if (seenPositions.has(tier.tierPosition)) {
+            errors.push(`Duplicate tierPosition ${tier.tierPosition} is not allowed`);
+        } else {
+            seenPositions.add(tier.tierPosition);
+        }
+
+        if (tier.upperBound !== 'inf' && !isNumericString(tier.upperBound)) {
+            errors.push('upperBound must be a numeric string or "inf"');
+        }
+
+        if (index > 0 && !isPresent(tier.unitPrice)) {
+            errors.push('Every tier after the first requires unitPrice');
+        }
+
+        if (isPresent(tier.unitPrice) && !isNumericString(tier.unitPrice)) {
+            errors.push('unitPrice must be a numeric string');
+        }
+    }
+
+    let previousBound = 0;
+    for (let index = 0; index < sorted.length; index++) {
+        const tier = sorted[index];
+        if (!tier) {
+            continue;
+        }
+        const isLast = index === sorted.length - 1;
+        if (tier.upperBound === 'inf') {
+            if (!isLast) {
+                errors.push('"inf" upperBound is only allowed on the last tier');
+            }
+            continue;
+        }
+        if (!isNumericString(tier.upperBound)) {
+            continue;
+        }
+        const bound = Number(tier.upperBound);
+        if (bound <= previousBound) {
+            errors.push('Tier upperBound values must increase without overlap');
+        }
+        if (canValidateIncrement && bound % increment !== 0) {
+            errors.push('Tier upperBound values must align to usageIncrement');
+        }
+        previousBound = bound;
+    }
+
+    return errors;
+};
+
+export type AllocatedTier = {
+    tier: DimensionTierDto;
+    allocatedUsage: number;
+};
+
+export const allocateUsageAcrossTiers = (totalUsage: number, tiers: DimensionTierDto[]): AllocatedTier[] => {
+    const sorted = [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+    const allocations: AllocatedTier[] = [];
+    let previousBound = 0;
+
+    for (const tier of sorted) {
+        const upperBound = tier.upperBound === 'inf' ? Number.POSITIVE_INFINITY : Number(tier.upperBound);
+        const allocatedUsage = Math.max(0, Math.min(totalUsage, upperBound) - previousBound);
+        if (allocatedUsage > 0) {
+            allocations.push({ tier, allocatedUsage });
+        }
+        previousBound = upperBound;
+        if (previousBound === Number.POSITIVE_INFINITY) {
+            break;
+        }
+    }
+
+    return allocations;
+};
