diff --git a/src/dimensions/dto/tiersValidator.spec.ts b/src/dimensions/dto/tiersValidator.spec.ts
new file mode 100644
index 0000000..50b6621
--- /dev/null
+++ b/src/dimensions/dto/tiersValidator.spec.ts
@@ -0,0 +1,102 @@
+import { TiersAreValidRule, allocateUsageAcrossTiers, hasActiveTiers } from './tiersValidator.js';
+import { overageAllowedEnum } from './create-dimension.dto.js';
+
+describe('Usage dimension tiers', () => {
+    const validator = new TiersAreValidRule();
+
+    const validTiers = [
+        { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02' },
+        { tierPosition: '1', upperBound: '1000', unitPrice: '0.05', tierName: 'Standard' },
+    ];
+
+    const validDto = {
+        usageIncrement: '1',
+        tiers: validTiers,
+    };
+
+    it('accepts increasing inclusive bounds with inf only at the end', () => {
+        expect(validator.validate(validTiers, { object: validDto } as any)).toBe(true);
+    });
+
+    it('allows an omitted first-tier unitPrice as a free tier', () => {
+        const tiers = [
+            { tierPosition: '1', upperBound: '100', tierName: 'Free' },
+            { tierPosition: '2', upperBound: 'inf', unitPrice: '0.10' },
+        ];
+        expect(validator.validate(tiers, { object: { usageIncrement: '1', tiers } } as any)).toBe(true);
+    });
+
+    it('rejects overlapping or decreasing bounds', () => {
+        const tiers = [
+            { tierPosition: '1', upperBound: '1000', unitPrice: '0.05' },
+            { tierPosition: '2', upperBound: '500', unitPrice: '0.02' },
+        ];
+        expect(validator.validate(tiers, { object: { usageIncrement: '1', tiers } } as any)).toBe(false);
+        expect(validator.defaultMessage()).toContain('increase without overlap');
+    });
+
+    it('rejects inf anywhere except the last tier', () => {
+        const tiers = [
+            { tierPosition: '1', upperBound: 'inf', unitPrice: '0.05' },
+            { tierPosition: '2', upperBound: '2000', unitPrice: '0.02' },
+        ];
+        expect(validator.validate(tiers, { object: { usageIncrement: '1', tiers } } as any)).toBe(false);
+        expect(validator.defaultMessage()).toContain('inf');
+    });
+
+    it('rejects bounds that do not align to usageIncrement', () => {
+        const tiers = [
+            { tierPosition: '1', upperBound: '15', unitPrice: '0.05' },
+            { tierPosition: '2', upperBound: 'inf', unitPrice: '0.02' },
+        ];
+        expect(validator.validate(tiers, { object: { usageIncrement: '10', tiers } } as any)).toBe(false);
+        expect(validator.defaultMessage()).toContain('usageIncrement');
+    });
+
+    it('requires unitPrice on every tier after the first', () => {
+        const tiers = [
+            { tierPosition: '1', upperBound: '100' },
+            { tierPosition: '2', upperBound: 'inf' },
+        ];
+        expect(validator.validate(tiers, { object: { usageIncrement: '1', tiers } } as any)).toBe(false);
+        expect(validator.defaultMessage()).toContain('unitPrice');
+    });
+
+    it('is mutually exclusive with usageEntitlement, consumptionPrice, and overageAllowed true', () => {
+        expect(
+            validator.validate(validTiers, {
+                object: { ...validDto, usageEntitlement: 100 },
+            } as any),
+        ).toBe(false);
+        expect(
+            validator.validate(validTiers, {
+                object: { ...validDto, consumptionPrice: '1.00' },
+            } as any),
+        ).toBe(false);
+        expect(
+            validator.validate(validTiers, {
+                object: { ...validDto, overageAllowed: overageAllowedEnum.true },
+            } as any),
+        ).toBe(false);
+    });
+
+    it('treats null or missing tiers as valid so they can be omitted or cleared', () => {
+        expect(validator.validate(undefined, { object: { usageIncrement: '1' } } as any)).toBe(true);
+        expect(validator.validate(null, { object: { usageIncrement: '1', tiers: null } } as any)).toBe(true);
+        expect(hasActiveTiers(null)).toBe(false);
+        expect(hasActiveTiers(undefined)).toBe(false);
+    });
+
+    it('allocates inclusive usage across numeric tierPosition order', () => {
+        const allocated = allocateUsageAcrossTiers(3500, validTiers);
+        expect(allocated.map(({ tier, usage }) => ({ position: tier.tierPosition, usage }))).toEqual([
+            { position: '1', usage: 1000 },
+            { position: '2', usage: 2500 },
+        ]);
+    });
+
+    it('does not allocate usage to unused higher tiers', () => {
+        const allocated = allocateUsageAcrossTiers(1000, validTiers);
+        expect(allocated.map(({ usage }) => usage)).toEqual([1000, 0]);
+    });
+});
diff --git a/src/dimensions/dto/tiersValidator.ts b/src/dimensions/dto/tiersValidator.ts
new file mode 100644
index 0000000..ceb9b74
--- /dev/null
+++ b/src/dimensions/dto/tiersValidator.ts
@@ -0,0 +1,248 @@
+import { Injectable } from '@nestjs/common';
+import {
+    IsNotEmpty,
+    IsNumberString,
+    IsOptional,
+    IsString,
+    ValidationArguments,
+    ValidationOptions,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+    registerDecorator,
+} from 'class-validator';
+import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';
+import { ValidateDecimalPlace } from './validateDecimalPlaces.js';
+
+export class UsageDimensionTierDto {
+    /**
+     * The position of the tier. Tiers are billed in numeric order of this field.
+     * Represented as a string to avoid precision loss.
+     */
+    @IsString()
+    @IsNotEmpty()
+    @IsNumberString()
+    @ApiProperty({
+        name: 'tierPosition',
+        example: '1',
+        type: String,
+        description: 'The position of the tier. Tiers are billed in numeric order of this field.',
+    })
+    public tierPosition: string;
+
+    /**
+     * Inclusive upper bound of usage for this tier.
+     * A numeric string or the string "inf" for an unbounded final tier.
+     */
+    @IsString()
+    @IsNotEmpty()
+    @ApiProperty({
+        name: 'upperBound',
+        example: '1000',
+        type: String,
+        description: 'Inclusive upper bound of usage for this tier. A numeric string or "inf".',
+    })
+    public upperBound: string;
+
+    /**
+     * Optional display name appended to the invoice line item for this tier.
+     */
+    @IsOptional()
+    @IsString()
+    @ApiPropertyOptional({
+        name: 'tierName',
+        example: 'Standard',
+        type: String,
+        description: 'Optional display name appended to the invoice line item for this tier.',
+    })
+    public tierName?: string;
+
+    /**
+     * Optional unit price for usage in this tier.
+     * Required for every tier after the first. An omitted first-tier price represents a free tier.
+     */
+    @IsOptional()
+    @IsString()
+    @IsNumberString()
+    @ValidateDecimalPlace('unitPrice')
+    @ApiPropertyOptional({
+        name: 'unitPrice',
+        example: '0.05',
+        type: String,
+        description:
+            'Optional unit price for usage in this tier. Required for every tier after the first. An omitted first-tier price represents a free tier.',
+    })
+    public unitPrice?: string;
+}
+
+export type DimensionWithOptionalTiers = {
+    usageIncrement?: string;
+    usageEntitlement?: number | 'inf' | null;
+    consumptionPrice?: string | null;
+    overageAllowed?: string | null;
+    tiers?: UsageDimensionTierDto[] | null;
+};
+
+export function parseTierUpperBound(upperBound: string): number {
+    if (upperBound === 'inf') {
+        return Number.POSITIVE_INFINITY;
+    }
+    return Number(upperBound);
+}
+
+export function isNumericString(value: unknown): value is string {
+    return typeof value === 'string' && value.trim() !== '' && !isNaN(Number(value)) && !isNaN(parseFloat(value));
+}
+
+function isNonNegativeIntegerString(value: unknown): boolean {
+    if (!isNumericString(value)) {
+        return false;
+    }
+    const numeric = Number(value);
+    return Number.isInteger(numeric) && numeric >= 0;
+}
+
+export function hasActiveTiers(tiers?: UsageDimensionTierDto[] | null): boolean {
+    return Array.isArray(tiers) && tiers.length > 0;
+}
+
+export function validateUsageDimensionTiers(
+    tiers: UsageDimensionTierDto[] | null | undefined,
+    dto: DimensionWithOptionalTiers,
+): string | null {
+    if (tiers === undefined || tiers === null) {
+        return null;
+    }
+    if (!Array.isArray(tiers)) {
+        return 'tiers must be an array or null';
+    }
+    if (tiers.length === 0) {
+        return 'tiers must contain at least one tier';
+    }
+
+    if (dto.usageEntitlement !== undefined && dto.usageEntitlement !== null) {
+        return 'tiers cannot be used together with usageEntitlement';
+    }
+    if (dto.consumptionPrice !== undefined && dto.consumptionPrice !== null) {
+        return 'tiers cannot be used together with consumptionPrice';
+    }
+    if (dto.overageAllowed === 'true') {
+        return 'tiers cannot be used together with overageAllowed: true';
+    }
+
+    const usageIncrement =
+        dto.usageIncrement !== undefined && dto.usageIncrement !== null ? Number(dto.usageIncrement) : undefined;
+    if (usageIncrement !== undefined && (!Number.isFinite(usageIncrement) || usageIncrement <= 0)) {
+        return 'tiers require a positive integer usageIncrement';
+    }
+
+    const seenPositions = new Set<number>();
+    let previousBound = 0;
+    let previousWasInf = false;
+    const sortedTiers = sortTiersByPosition(tiers);
+
+    for (let index = 0; index < sortedTiers.length; index++) {
+        const tier = sortedTiers[index];
+        if (!tier || typeof tier !== 'object') {
+            return 'each tier must be an object';
+        }
+
+        if (!isNonNegativeIntegerString(tier.tierPosition)) {
+            return 'tierPosition must be a numeric string representing a non-negative integer';
+        }
+        const position = Number(tier.tierPosition);
+        if (seenPositions.has(position)) {
+            return 'tierPosition values must be unique';
+        }
+        seenPositions.add(position);
+
+        if (typeof tier.upperBound !== 'string' || tier.upperBound.trim() === '') {
+            return 'upperBound must be a numeric string or "inf"';
+        }
+        const isInf = tier.upperBound === 'inf';
+        if (!isInf && !isNumericString(tier.upperBound)) {
+            return 'upperBound must be a numeric string or "inf"';
+        }
+        if (isInf && index !== sortedTiers.length - 1) {
+            return '"inf" upperBound is only allowed on the last tier';
+        }
+        if (previousWasInf) {
+            return '"inf" upperBound is only allowed on the last tier';
+        }
+
+        const currentBound = isInf ? Number.POSITIVE_INFINITY : Number(tier.upperBound);
+        if (!isInf) {
+            if (currentBound <= 0) {
+                return 'upperBound must be greater than 0';
+            }
+            if (usageIncrement !== undefined && currentBound % usageIncrement !== 0) {
+                return 'upperBound must align to usageIncrement';
+            }
+        }
+        if (currentBound <= previousBound) {
+            return 'tier upperBound values must increase without overlap';
+        }
+
+        if (index === 0) {
+            if (tier.unitPrice !== undefined && tier.unitPrice !== null && !isNumericString(tier.unitPrice)) {
+                return 'unitPrice must be a numeric string';
+            }
+        } else if (!isNumericString(tier.unitPrice)) {
+            return 'every tier after the first requires unitPrice';
+        }
+
+        previousBound = currentBound;
+        previousWasInf = isInf;
+    }
+
+    return null;
+}
+
+export function sortTiersByPosition(tiers: UsageDimensionTierDto[]): UsageDimensionTierDto[] {
+    return [...tiers].sort((a, b) => Number(a.tierPosition) - Number(b.tierPosition));
+}
+
+export function allocateUsageAcrossTiers(
+    totalUsage: number,
+    tiers: UsageDimensionTierDto[],
+): Array<{ tier: UsageDimensionTierDto; usage: number }> {
+    const sortedTiers = sortTiersByPosition(tiers);
+    let previousBound = 0;
+    return sortedTiers.map((tier) => {
+        const currentBound = parseTierUpperBound(tier.upperBound);
+        const usage = Math.max(0, Math.min(totalUsage, currentBound) - previousBound);
+        previousBound = currentBound;
+        return { tier, usage };
+    });
+}
+
+@ValidatorConstraint({ name: 'TiersAreValid', async: false })
+@Injectable()
+export class TiersAreValidRule implements ValidatorConstraintInterface {
+    private message = 'Invalid tiers';
+
+    validate(tiers: UsageDimensionTierDto[] | null | undefined, args: ValidationArguments) {
+        const error = validateUsageDimensionTiers(tiers, args.object as DimensionWithOptionalTiers);
+        if (error) {
+            this.message = error;
+            return false;
+        }
+        return true;
+    }
+
+    defaultMessage() {
+        return this.message;
+    }
+}
+
+export function TiersAreValid(property: string, validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'TiersAreValid',
+            target: (object as { constructor: new (...args: unknown[]) => unknown }).constructor,
+            propertyName: propertyName,
+            constraints: [property],
+            options: validationOptions,
+            validator: TiersAreValidRule,
+        });
+    };
+}
