+    /**
+     * Usage a dimension may charge for: only the permitted overage past a
+     * finite exhausted allowance. An unlimited or unexhausted allowance, or
+     * a plan that forbids overage, charges nothing.
+     */
+    static permittedUsage(total: number, dimension: ReadDimensionResponseData): number {
+        const entitlement = dimension?.usageEntitlement;
+        if (entitlement === undefined || entitlement === null || entitlement === '') {
+            return total;
+        }
+        if (entitlement === 'inf') {
+            return 0;
+        }
+        if (dimension?.overageAllowed !== overageAllowedEnum.true) {
+            return 0;
+        }
+        const allowance = typeof entitlement === 'number' ? entitlement : parseFloat(String(entitlement));
+        if (!Number.isFinite(allowance)) {
+            return 0;
+        }
+        const overage = Number((Number(total) - allowance).toFixed(2));
+        return overage > 0 ? overage : 0;
+    }
+
+    /**
+     * Whether a dimension earns a line: the customer owes something on it,
+     * and a plan that prices the dimension at zero is shown unless invoice
+     * settings hide free dimensions.
+     */
+    static shouldInvoiceDimension({
+        owedQuantity,
+        unitCost,
+        settings,
+    }: {
+        owedQuantity: number;
+        unitCost: number;
+        settings?: ReadSettingsResponseData;
+    }): boolean {
+        if (!Number.isFinite(owedQuantity) || owedQuantity <= 0) {
+            return false;
+        }
+        if (unitCost === 0 && settings?.freeDimensionOnInvoice === FreeDimensionOnInvoice.hide) {
+            return false;
+        }
+        return true;
+    }
