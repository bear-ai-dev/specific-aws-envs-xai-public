@@ -0,0 +1,158 @@
+/*
+ * Tax determination, written as plain functions rather than an injected
+ * service: the invoice already holds everything the authority needs, so there
+ * is nothing for a collaborator to look up.
+ */
+import { BadRequestException } from '@nestjs/common';
+
+const EU = new Set([
+    'AT', 'BE', 'BG', 'CY', 'CZ', 'DK', 'DE', 'EE', 'EL', 'ES', 'FI', 'FR', 'GR',
+    'HR', 'IT', 'HU', 'IE', 'LV', 'LT', 'LU', 'MT', 'NL', 'PL', 'PT', 'RO', 'SI',
+    'SK', 'SE', 'GB', 'UK',
+]);
+
+export const inEuropeanUnion = (code: string): boolean => !!code && EU.has(code.toUpperCase());
+
+export const vatLine = (code: string, vatId: string): string =>
+    inEuropeanUnion(code) && vatId ? `VAT Registration Number: ${vatId}` : '';
+
+export type Jurisdiction = {
+    fromCountry: string;
+    fromZip: string;
+    fromState: string;
+    fromCity: string;
+    fromStreet: string;
+    toCountry: string;
+    toZip: string;
+    toState: string;
+    toCity: string;
+    toStreet: string;
+};
+
+export type PricedLine = { quantity: number; unitCost: number };
+
+const authorityBase = (accountState: string): string =>
+    accountState === 'production' ? process.env.PROD_TAX_JAR_URL : process.env.TAX_JAR_URL;
+
+async function callAuthority(accountState: string, apiKey: string, resource: string, payload: unknown) {
+    const response = await fetch(`${authorityBase(accountState)}/v2/${resource}`, {
+        method: 'POST',
+        headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
+        body: JSON.stringify(payload),
+    });
+    const body = await response.json().catch(() => ({}));
+    if (!response.ok) {
+        const detail = (body as any)?.detail ?? response.statusText;
+        const error: any = new Error(`${(body as any)?.error ?? 'Error'} - ${detail}`);
+        error.status = response.status;
+        throw error;
+    }
+    return body as any;
+}
+
+/* Returns the fraction of the net total this invoice owes. Anything the
+ * authority rejects for how the address is put together is reported back
+ * alongside a zero rate rather than stopping the invoice. */
+export async function determineRate(options: {
+    accountState: string;
+    apiKey: string;
+    exempt: boolean;
+    regime: string;
+    manualRate: string | number;
+    taxCategory: string;
+    jurisdiction: Jurisdiction;
+    lines: PricedLine[];
+}): Promise<{ rate: number; error?: { message: string } }> {
+    if (options.exempt) {
+        return { rate: 0 };
+    }
+    if (options.regime === 'manual') {
+        return { rate: Number(options.manualRate) };
+    }
+    if (options.regime !== 'meteringcoCalculated') {
+        return { rate: 0 };
+    }
+    if (!options.apiKey) {
+        throw new BadRequestException('TaxJar API Key is not set');
+    }
+    const j = options.jurisdiction;
+    try {
+        const quote = await callAuthority(options.accountState, options.apiKey, 'taxes', {
+            from_country: j.fromCountry,
+            from_zip: j.fromZip,
+            from_state: j.fromState,
+            from_city: j.fromCity,
+            from_street: j.fromStreet,
+            to_country: j.toCountry,
+            to_zip: j.toZip,
+            to_state: j.toState,
+            to_city: j.toCity,
+            to_street: j.toStreet,
+            shipping: 0,
+            line_items: options.lines.map((line) => ({
+                quantity: line.quantity,
+                product_tax_code: options.taxCategory,
+                unit_price: line.unitCost,
+            })),
+        });
+        return { rate: quote?.tax?.rate ?? 0 };
+    } catch (error: any) {
+        if (error?.status === 400) {
+            return { rate: 0, error: { message: error.message } };
+        }
+        throw error;
+    }
+}
+
+/* Files the settled invoice with the authority. A destination that is not
+ * pinned down to a state, country and postcode is not filed at all, and an
+ * account with no credential has nowhere to file it. */
+export async function fileTransaction(options: {
+    accountState: string;
+    apiKey: string;
+    transactionId: string;
+    amount: number;
+    salesTax: number;
+    taxCategory: string;
+    lines: PricedLine[];
+    address: {
+        streetLineOne: string;
+        streetLineTwo: string;
+        city: string;
+        state: string;
+        postalCode: string;
+        countryCode: string;
+    };
+}): Promise<unknown | null> {
+    const { address } = options;
+    if (!address.state || !address.countryCode || !address.postalCode) {
+        return null;
+    }
+    if (!options.apiKey) {
+        return null;
+    }
+    try {
+        return await callAuthority(options.accountState, options.apiKey, 'transactions/orders', {
+            transaction_id: options.transactionId,
+            transaction_date: new Date().toISOString(),
+            provider: 'meteringco',
+            to_country: address.countryCode,
+            to_zip: address.postalCode,
+            to_state: address.state,
+            to_city: address.city,
+            to_street: address.streetLineTwo
+                ? `${address.streetLineOne} ${address.streetLineTwo}`
+                : address.streetLineOne,
+            amount: options.amount,
+            shipping: 0,
+            sales_tax: options.salesTax,
+            line_items: options.lines.map((line) => ({
+                quantity: line.quantity,
+                product_tax_code: options.taxCategory,
+                unit_price: line.unitCost,
+            })),
+        });
+    } catch {
+        return null;
+    }
+}
