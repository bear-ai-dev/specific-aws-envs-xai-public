+/**
+ * Runs `collect` once in every region the account is switched on in.
+ *
+ * A region that answers is in the result even when it held nothing, so an empty
+ * region reads as "looked, found nothing". A region that will not let us read it
+ * is left out entirely rather than reported as empty, and it does not take the
+ * rest of the sweep down with it.
+ */
+const sweepAllRegions = async <T>(
+    creds,
+    label: string,
+    collect: (ec2Client: EC2Client) => Promise<Array<T>>,
+): Promise<Record<string, Array<T>>> => {
+    const regions = await getAllRegions(creds);
+    console.log(`Starting ${label} across`, regions);
 
-    return { [region]: snapshots };
+    const swept = await Promise.all(
+        regions.map(async (region) => {
+            const ec2Client = new EC2Client({ credentials: creds, region, maxAttempts: REGION_ATTEMPTS });
+            try {
+                return { region, found: await collect(ec2Client) };
+            } catch (error) {
+                console.log(`Could not read ${region}, leaving it out of the ${label}`, error?.name || error);
+                return undefined;
+            }
+        }),
+    );
+
+    return swept.reduce((acc, outcome) => {
+        if (outcome) {
+            acc[outcome.region] = outcome.found;
+        }
+        return acc;
+    }, {} as Record<string, Array<T>>);
 };
+
+export const getAllVolumes = async (creds, Filters: Array<Filter> = []): Promise<Record<string, Array<Volume>>> =>
+    sweepAllRegions<Volume>(creds, 'volume sweep', async (ec2Client) => {
+        const volumes: Array<Volume> = [];
+        let next: string;
+        do {
+            // Need to do this for pagination
+            // eslint-disable-next-line no-await-in-loop
+            const response = await ec2Client.send(new DescribeVolumesCommand({ Filters, NextToken: next }));
