{
    "name": "meteringco-backend",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "start:influx": "sudo docker start influxdb",
        "pre-commit": "npm run lint",
        "pre-push": "npm run build && npm run test",
        "stop:influx": "sudo docker stop influxdb",
        "setup:influx": "sudo docker pull influxdb:2.5.0 & sudo docker run --name influxdb -p 8086:8086 influxdb:2.5.0",
        "setup:redis": "sudo docker run --name bullmq-redis -p 6379:6379 -d redis redis-server --save 60 1 --loglevel warning",
        "stop:redis": "sudo docker stop bullmq-redis",
        "start:redis": "sudo docker start bullmq-redis",
        "prebuild": "rimraf dist",
        "cleanup": "kind delete cluster && docker image rm meteringco-agent-transformer:local",
        "cleanup:integration": "npm run stop:influx && npm run stop:redis",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "deploy:dev": "sls deploy --stage=dev",
        "deploy:prod": "sls deploy --stage=prod",
        "start:generic": "node dist/genericExpressEnv",
        "start:lambda": "node dist/lambda",
        "generate:private:specification": "node dist/openApiSpecGenerator && redoc-cli bundle -o ./docs/private_api.html ./docs/open-api-private-spec.json",
        "generate:public:specification": "node dist/openApiPublicSpecGenerator && redoc-cli bundle --options.theme.shape.borderRadius=0 --options.hideDownloadButton=true --options.theme.typography.fontSize=14px -o ./docs/public_api.html ./docs/open-api-public-spec.json",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "prepare": "husky install",
        "prepare:integration": "npm run start:influx && npm run start:redis",
        "prepare:kindcluster": "kind create cluster --config ./resources/kind-config.yaml && kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/kind/deploy.yaml &&  kubectl wait --namespace ingress-nginx --for=condition=ready pod --selector=app.kubernetes.io/component=controller --timeout=90s&& helm repo add bitnami https://charts.bitnami.com/bitnami && helm install my-release bitnami/redis && export REDIS_PASSWORD=$(kubectl get secret --namespace default my-release-redis -o jsonpath=\"{.data.redis-password}\" | base64 -d) && npm run build-docker-integration && sed -i \"s/REDIS_PASSWORD=.*/REDIS_PASSWORD=$REDIS_PASSWORD/\" .env && kind load docker-image meteringco-agent-transformer:local && kubectl apply -f ./resources/local/deployment_local.yml && export POD=$(kubectl get pod -l app=meteringco-agent-transformer -o jsonpath=\"{.items[0].metadata.name}\") ",
        "test": "jest --config ./jest.unit.config.json",
        "test:ci": "jest --config ./jest.unit.config.json --forceExit",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:local:integration": "jest --config ./integration/jest.local.config.json",
        "test:ci:integration": "jest --config ./integration/jest.ci.config.json",
        "deploy:specification": "node docs/deployDocument.js",
        "build-docker": "docker build -t meteringco-agent-transformer --no-cache .",
        "build-docker-integration": "docker build -t meteringco-agent-transformer:local --no-cache .",
        "development:refresh:integration": "npm run build-docker-integration && kind load docker-image meteringco-agent-transformer:local && kubectl rollout restart deployment meteringco-agent-transformer",
        "run-docker": "docker run -p 3000:3000 meteringco-agent-transformer",
        "push-image-dev": "docker tag meteringco-agent-transformer 647662420899.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:latest && docker push 647662420899.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:latest",
        "push-image-prod": "docker tag meteringco-agent-transformer 647662420899.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:prod && docker push 647662420899.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:prod"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-cloudtrail": "^3.118.1",
        "@aws-sdk/client-cloudwatch": "^3.112.0",
        "@aws-sdk/client-cost-explorer": "^3.112.0",
        "@aws-sdk/client-ec2": "^3.112.0",
        "@aws-sdk/client-pricing": "^3.112.0",
        "@aws-sdk/client-s3": "^3.87.0",
        "@aws-sdk/client-ses": "^3.112.0",
        "@aws-sdk/client-ssm": "^3.112.0",
        "@aws-sdk/credential-providers": "^3.112.0",
        "@aws-sdk/hash-node": "^3.78.0",
        "@aws-sdk/lib-storage": "^3.87.0",
        "@aws-sdk/protocol-http": "^3.78.0",
        "@aws-sdk/s3-request-presigner": "^3.88.0",
        "@aws-sdk/types": "^3.226.0",
        "@aws-sdk/url-parser": "^3.78.0",
        "@aws-sdk/util-format-url": "^3.78.0",
        "@influxdata/influxdb-client": "^1.25.0",
        "@influxdata/influxdb-client-apis": "^1.25.0",
        "@nestjs/bull": "^0.6.2",
        "@nestjs/common": "^9.2.1",
        "@nestjs/config": "^2.2.0",
        "@nestjs/core": "^9.2.1",
        "@nestjs/mapped-types": "^1.2.0",
        "@nestjs/passport": "^9.0.0",
        "@nestjs/platform-express": "^9.2.1",
        "@nestjs/schedule": "^2.1.0",
        "@nestjs/swagger": "^6.1.4",
        "@nestjs/typeorm": "^9.0.1",
        "@vendia/serverless-express": "^4.8.0",
        "aws-lambda": "^1.0.7",
        "bull": "^4.10.1",
        "cache-manager": "^4.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.13.2",
        "cross-fetch": "^3.1.5",
        "jwks-rsa": "^2.1.3",
        "lodash.chunk": "^4.2.0",
        "lodash.flattendeep": "^4.4.0",
        "lodash.isequal": "^4.5.0",
        "node-fetch": "^3.2.6",
        "node-snappy": "^0.1.4",
        "passport": "^0.6.0",
        "passport-jwt": "^4.0.0",
        "pdfkit": "^0.13.0",
        "protobufjs": "^7.0.0",
        "redis": "^4.5.0",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "rxjs": "^7.2.0",
        "snappy": "^7.1.1",
        "snappy-stream": "^3.0.2",
        "snappyjs": "^0.7.0",
        "stripe": "^10.8.0",
        "swagger-ui-express": "^4.4.0",
        "taxjar": "^4.0.1"
    },
    "devDependencies": {
        "@aws-sdk/client-lambda": "^3.105.0",
        "@nestjs/cli": "^9.1.8",
        "@nestjs/schematics": "^9.0.4",
        "@nestjs/testing": "^9.2.1",
        "@types/aws-lambda": "^8.10.97",
        "@types/bull": "^4.10.0",
        "@types/cache-manager": "^4.0.2",
        "@types/cron": "^2.0.0",
        "@types/express": "^4.17.13",
        "@types/jest": "27.5.0",
        "@types/multer": "^1.4.7",
        "@types/node": "^16.0.0",
        "@types/supertest": "^2.0.11",
        "@typescript-eslint/eslint-plugin": "^5.24.0",
        "@typescript-eslint/parser": "^5.0.0",
        "aws-sdk-client-mock": "^2.0.1",
        "eslint": "^8.15.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "husky": "^8.0.1",
        "jest": "^28.1.0",
        "prettier": "^2.6.2",
        "serverless": "^3.16.0",
        "serverless-dotenv-plugin": "^4.0.0",
        "serverless-offline": "^8.8.0",
        "source-map-support": "^0.5.20",
        "supertest": "^6.1.3",
        "ts-jest": "28.0.1",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.0.0",
        "typescript": "^4.3.5"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
